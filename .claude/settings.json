{
  "model": "opus",
  "effortLevel": "xhigh",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/notation-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking notation conventions..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/results-no-overwrite.sh",
            "timeout": 30,
            "statusMessage": "Checking results no-overwrite rule..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch-readiness-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking Manager dispatch readiness..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/mirror-tree-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking skill mirror-tree write boundary..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import sys,json; d=json.load(sys.stdin); print(d.get('tool_input',{}).get('file_path',''))\" | { read -r f; [[ \"$f\" == *.py ]] && uv run ruff check --fix \"$f\" && uv run ruff format \"$f\"; } 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Linting and formatting..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/research-context-check.sh",
            "timeout": 10,
            "statusMessage": "Checking research context header..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/results-vault-reminder.sh",
            "timeout": 5,
            "statusMessage": "Checking for vault reminder..."
          }
        ]
      }
    ]
  }
}
