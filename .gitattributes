.gitattributes text eol=lf

# The contract system declares `canonical_byte_surface: git_blob_utf8_lf`, and its
# validators hash or assert working-tree bytes against that surface — WP6.1 rejects
# non-LF artifacts outright ("artifact must use canonical LF bytes"), while WP6.2 and
# WP6.3 compare `sha256(bytes)` against pinned `*_lf_sha256` values. On a checkout with
# `core.autocrlf=true` (the Windows default) git materialises these LF blobs as CRLF, so
# every such contract fails locally while passing on any LF checkout, including CI.
#
# These patterns cover the whole class deliberately. This file was previously grown one
# path at a time as each work package hit the failure, which left WP6.1's
# stage1-owner-acceptance-record, all of WP6.2 T3/T4, and all of WP6.3 uncovered — 133
# failing contract tests from a single unset attribute. Every tracked file under these
# roots is committed pure-LF and non-binary, so this changes no committed content.
.research-system/** text eol=lf
tests/research_system/contracts/** text eol=lf

docs/plans/agentic-research-system/design/09-wp6-2-t2-cost-grant-authority-addendum-2026-07-22.md text eol=lf
