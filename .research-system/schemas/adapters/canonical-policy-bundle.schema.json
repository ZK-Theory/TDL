{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://adapters/canonical-policy-bundle",
  "type": "object",
  "required": ["schema_id", "schema_version", "canonical_policy_bundle_id", "revision", "content_hash", "controls"],
  "properties": {
    "schema_id": {"const": "ars://adapters/canonical-policy-bundle"},
    "schema_version": {"const": "1.0.0"},
    "canonical_policy_bundle_id": {"type": "string", "pattern": "^cpb_"},
    "revision": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "controls": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["control_id", "revision"], "properties": {"control_id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}}, "additionalProperties": true}}
  },
  "additionalProperties": false
}
