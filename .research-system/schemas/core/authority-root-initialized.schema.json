{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://core/event/AuthorityRootInitialized/payload",
  "type": "object",
  "required": ["bootstrap_manifest_sha256", "authorizing_grant_id", "authorizing_grant_sha256", "activated_grant_id", "activated_grant_sha256"],
  "properties": {
    "bootstrap_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorizing_grant_id": {"type": "string", "pattern": "^agr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "authorizing_grant_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "activated_grant_id": {"type": "string", "pattern": "^agr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "activated_grant_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
