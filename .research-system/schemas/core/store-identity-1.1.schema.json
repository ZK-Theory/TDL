{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://core/store-identity/1.1",
  "type": "object",
  "required": ["schema_id", "schema_version", "store_nonce", "project_id", "bootstrap_manifest_sha256", "store_identity", "control_root", "code_roots", "endpoint_scheme", "manifest_hash"],
  "properties": {
    "schema_id": {"const": "ars://core/store-identity"},
    "schema_version": {"const": "1.1.0"},
    "store_nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "bootstrap_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "store_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "control_root": {"type": "string", "minLength": 1},
    "code_roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "schema_root": {"type": "string", "minLength": 1},
    "endpoint_scheme": {"const": "local-cli"},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
