{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://core/task",
  "type": "object",
  "description": "WP1 freezes the Task status vocabulary; object-level Task validation begins when WP2 first persists full Task definitions.",
  "required": ["schema_id", "schema_version", "task_id", "record_revision", "status", "content_hash"],
  "properties": {
    "schema_id": {"const": "ars://core/task"},
    "schema_version": {"const": "1.0.0"},
    "task_id": {"type": "string", "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "record_revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "readiness_pending", "ready", "in_progress", "review_pending", "blocked", "input_required", "paused", "accepted", "rejected", "partial", "cancelled", "superseded"]},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}