{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://core/command/RevokeAuthorityGrant/payload",
  "type": "object",
  "required": ["project_id", "target_grant_id", "target_grant_sha256", "authority_grant_sha256", "reason"],
  "properties": {
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "target_grant_id": {"type": "string", "pattern": "^agr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "target_grant_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_grant_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reason": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
