{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://wp6-6/gate6/authority/object/CanonicalAuthorityActor",
  "title": "Canonical authority actor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "actor_id", "project_id", "store_identity", "owner_actor_id", "canonical_display_name", "actor_class", "app_family", "observed_app_version", "session_identity", "session_purpose", "actor_role", "authority_lane", "effective_at", "expires_at", "evidence_refs", "reason", "owner_action", "registration_id", "revoked"],
  "properties": {
    "schema_id": {"const": "ars://wp6-6/gate6/authority/object/CanonicalAuthorityActor"},
    "schema_version": {"const": "1.0.0"},
    "actor_id": {"type": "string", "pattern": "^act_"},
    "project_id": {"type": "string", "pattern": "^prj_"},
    "store_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "owner_actor_id": {"type": "string", "pattern": "^act_"},
    "canonical_display_name": {"type": "string", "minLength": 1},
    "actor_class": {"enum": ["agent", "service"]},
    "app_family": {"const": "codex_desktop"},
    "observed_app_version": {"type": "string", "minLength": 1},
    "session_identity": {"type": "string", "minLength": 1},
    "session_purpose": {"type": "string", "minLength": 1},
    "actor_role": {"enum": ["producer", "independent_reviewer", "operator"]},
    "authority_lane": {"type": "string", "minLength": 1},
    "effective_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "expires_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "reason": {"type": "string", "minLength": 1},
    "owner_action": {"const": "register-codex-desktop-actor"},
    "registration_id": {"type": "string", "pattern": "^arec_"},
    "revoked": {"const": false}
  }
}
