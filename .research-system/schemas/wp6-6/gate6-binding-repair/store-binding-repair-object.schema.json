{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://wp6-6/gate6/binding-repair/object/StoreBindingRepair",
  "type": "object",
  "required": ["schema_id", "schema_version", "project_id", "store_identity", "control_root", "code_roots", "schema_root", "origin_witness_sha256", "git_head", "git_tree", "git_clean", "schema_catalogue_sha256", "route", "sources", "stale_evidence", "command_payload_hash", "prior_restore_transaction_id", "prior_restore_intended_manifest_sha256", "binding_config_path", "binding_config_sha256"],
  "additionalProperties": false,
  "properties": {
    "schema_id": {"const": "ars://internal/store-binding-recovery"}, "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "pattern": "^prj_"}, "store_identity": {"$ref": "#/$defs/sha256"},
    "control_root": {"type": "string"}, "code_roots": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}},
    "schema_root": {"type": "string"}, "origin_witness_sha256": {"$ref": "#/$defs/sha256"},
    "git_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "git_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "git_clean": {"const": true},
    "schema_catalogue_sha256": {"$ref": "#/$defs/sha256"}, "route": {"type": "object"}, "sources": {"type": "array", "minItems": 2, "maxItems": 2},
    "stale_evidence": {"type": "object"}, "command_payload_hash": {"$ref": "#/$defs/sha256"},
    "owner_actor_id": {"type": "string", "pattern": "^act_"}, "owner_action": {"const": "repair-stale-store-binding"}, "idempotency_key": {"type": "string"},
    "prior_restore_transaction_id": {"type": "string", "minLength": 1}, "prior_restore_intended_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "binding_config_path": {"const": "manifests/binding-repair-control-binding.json"}, "binding_config_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
