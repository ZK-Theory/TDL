{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://wp6-6/gate6/binding-repair/intent/RepairStoreBinding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "command_type", "control_root", "candidate_repository_root", "expected_project_id", "expected_store_identity", "expected_origin_authority_root", "expected_origin_witness_sha256", "intended_schema_root", "stale_evidence_refs", "spec_route_ref", "spec_source_refs", "valid_from", "expires_at", "owner_actor_id", "owner_action", "idempotency_key", "reason"],
  "properties": {
    "schema_id": {"const": "ars://wp6-6/gate6/binding-repair/intent/RepairStoreBinding"},
    "schema_version": {"const": "1.0.0"},
    "command_type": {"const": "RepairStoreBinding"},
    "control_root": {"type": "string", "minLength": 1}, "candidate_repository_root": {"type": "string", "minLength": 1},
    "expected_project_id": {"type": "string", "pattern": "^prj_"}, "expected_store_identity": {"$ref": "#/$defs/sha256"},
    "expected_origin_authority_root": {"type": "string", "minLength": 1}, "expected_origin_witness_sha256": {"$ref": "#/$defs/sha256"},
    "intended_schema_root": {"type": "string", "minLength": 1},
    "stale_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "spec_route_ref": {"const": ".research-system/contracts/wp6-6/spec-gate6-run-v1/route-package.json"},
    "spec_source_refs": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "prefixItems": [{"const": ".research-system/contracts/wp6-6/spec-gate6-run-v1/spec-01-assay-brief-v1.1.0.md"}, {"const": ".research-system/contracts/wp6-6/spec-gate6-run-v1/spec-02-micro-spike-contract-v1.1.0.md"}], "items": false},
    "valid_from": {"$ref": "#/$defs/utc"}, "expires_at": {"$ref": "#/$defs/utc"},
    "owner_actor_id": {"type": "string", "pattern": "^act_"}, "owner_action": {"const": "repair-stale-store-binding"},
    "idempotency_key": {"type": "string", "minLength": 8}, "reason": {"type": "string", "minLength": 12}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"}}
}
