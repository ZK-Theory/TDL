{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "ars://wp6-6/spec-owner-context/event-common",
  "$defs": {"envelope": {"type": "object", "additionalProperties": false, "properties": {
    "event_id": {"type": "string", "pattern": "^evt_"}, "event_type": {"type": "string"}, "schema_id": {"type": "string"}, "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "pattern": "^prj_"}, "stream_id": {"type": "string", "pattern": "^ctx_"}, "stream_version": {"type": "integer", "minimum": 1}, "global_position": {"type": "integer", "minimum": 1},
    "transaction_id": {"type": "string", "pattern": "^txb_"}, "transaction_index": {"type": "integer", "minimum": 1}, "transaction_count": {"type": "integer", "minimum": 1},
    "command_id": {"type": "string", "pattern": "^cmd_"}, "command_type": {"type": "string"}, "command_schema_id": {"type": "string"}, "command_schema_version": {"const": "1.0.0"}, "command_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idempotency_key": {"type": "string", "minLength": 1}, "command_payload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "correlation_id": {"type": "string", "minLength": 1}, "causation_id": {"type": ["string", "null"], "minLength": 1},
    "actor_id": {"type": "string", "pattern": "^act_"}, "authority_grant_id": {"type": "string", "pattern": "^agr_"}, "occurred_at": {"type": ["string", "null"], "format": "date-time", "pattern": "Z$"}, "recorded_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "payload": {"type": "object"}, "previous_event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }, "required": ["event_id", "event_type", "schema_id", "schema_version", "project_id", "stream_id", "stream_version", "global_position", "transaction_id", "transaction_index", "transaction_count", "command_id", "command_type", "command_schema_id", "command_schema_version", "command_schema_sha256", "idempotency_key", "command_payload_hash", "correlation_id", "causation_id", "actor_id", "authority_grant_id", "occurred_at", "recorded_at", "payload", "previous_event_hash", "event_hash"]}}
}
