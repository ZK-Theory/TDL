{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://wp6-4/owner-operated-session-brief",
  "title": "WP6.4 owner-operated session brief",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "document_type",
    "document_state",
    "mechanics_scope",
    "provider_control",
    "brief_artifact_id",
    "revision",
    "handoff_id",
    "session_id",
    "attempt_id",
    "task_id",
    "requested_role",
    "assurance_requirement",
    "operator_identity_locator",
    "producer_identity_locator",
    "session_family",
    "git_subject",
    "brief",
    "prepared_at"
  ],
  "properties": {
    "schema_id": {"const": "ars://wp6-4/owner-operated-session-brief"},
    "schema_version": {"const": "1.0.0"},
    "document_type": {"const": "owner_operated_session_brief"},
    "document_state": {"const": "prepared_for_owner_operated_session"},
    "mechanics_scope": {"const": "fixture_or_operator_supplied_inputs_only"},
    "provider_control": {"const": "owner_operated_no_ars_transport"},
    "brief_artifact_id": {"$ref": "#/$defs/artifactId"},
    "revision": {"const": 1},
    "handoff_id": {"$ref": "#/$defs/handoffId"},
    "session_id": {"$ref": "#/$defs/sessionId"},
    "attempt_id": {"$ref": "#/$defs/attemptId"},
    "task_id": {"$ref": "#/$defs/taskId"},
    "requested_role": {"type": "string", "minLength": 1, "maxLength": 256},
    "assurance_requirement": {"type": "string", "minLength": 1, "maxLength": 512},
    "operator_identity_locator": {"$ref": "#/$defs/locator"},
    "producer_identity_locator": {"$ref": "#/$defs/locator"},
    "session_family": {"enum": ["codex_standalone", "claude_standalone"]},
    "git_subject": {
      "type": "object",
      "required": ["commit_sha", "tree_sha"],
      "properties": {
        "commit_sha": {"$ref": "#/$defs/gitSha"},
        "tree_sha": {"$ref": "#/$defs/gitSha"}
      },
      "additionalProperties": false
    },
    "brief": {
      "type": "object",
      "required": ["media_type", "body_text", "raw_sha256", "byte_length"],
      "properties": {
        "media_type": {"const": "text/plain; charset=utf-8"},
        "body_text": {"type": "string", "minLength": 1},
        "raw_sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "prepared_at": {"$ref": "#/$defs/utcTimestamp"}
  },
  "additionalProperties": false,
  "$defs": {
    "uuid7": {"type": "string", "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "artifactId": {"type": "string", "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "handoffId": {"type": "string", "pattern": "^hnd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "sessionId": {"type": "string", "pattern": "^ses_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "attemptId": {"type": "string", "pattern": "^att_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "taskId": {"type": "string", "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "locator": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$", "maxLength": 2048},
    "utcTimestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"}
  }
}
