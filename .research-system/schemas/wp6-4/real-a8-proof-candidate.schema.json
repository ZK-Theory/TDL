{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://wp6-4/real-a8-proof-candidate",
  "title": "WP6.4 real-A8 proof candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "schema_id",
    "schema_version",
    "workflow_system",
    "lifecycle_phase",
    "proof_scope",
    "candidate_lifecycle",
    "foundation",
    "external_operation",
    "restart",
    "admission",
    "registry",
    "bound_artifacts",
    "retry_recovery",
    "rejected_admission",
    "git",
    "environment",
    "produced_files"
  ],
  "properties": {
    "candidate_id": {"type": "string", "pattern": "^a8c_[0-9a-f]{64}$"},
    "schema_id": {"const": "ars://wp6-4/real-a8-proof-candidate"},
    "schema_version": {"const": "1.0.0"},
    "workflow_system": {"const": "standalone"},
    "lifecycle_phase": {"const": "WP6.4"},
    "proof_scope": {"const": "real_external_store_moved_store"},
    "candidate_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_status", "a8_status", "independent_review", "owner_acceptance", "dispatch_claim", "research_claim"],
      "properties": {
        "candidate_status": {"const": "produced_unreviewed"},
        "a8_status": {"const": "open"},
        "independent_review": {"const": "pending"},
        "owner_acceptance": {"const": "pending"},
        "dispatch_claim": {"const": "none"},
        "research_claim": {"const": "none"}
      }
    },
    "foundation": {"$ref": "#/$defs/foundation"},
    "external_operation": {"$ref": "#/$defs/externalOperation"},
    "restart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process", "exit_code", "binding_load", "control_root", "project_id", "store_identity", "stdout_sha256", "stderr_sha256", "interpreter", "original_root_state"],
      "properties": {
        "process": {"const": "fresh"},
        "exit_code": {"const": 0},
        "binding_load": {"const": "successful"},
        "control_root": {"$ref": "#/$defs/absolutePath"},
        "project_id": {"type": "string", "minLength": 1},
        "store_identity": {"$ref": "#/$defs/sha256"},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "interpreter": {"$ref": "#/$defs/absolutePath"},
        "original_root_state": {"const": "unavailable"}
      }
    },
    "admission": {"$ref": "#/$defs/admission"},
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "raw_sha256"],
      "properties": {"file": {"$ref": "#/$defs/fileRecord"}, "raw_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "bound_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "raw_sha256"],
        "properties": {"file": {"$ref": "#/$defs/fileRecord"}, "raw_sha256": {"$ref": "#/$defs/sha256"}}
      }
    },
    "retry_recovery": {"$ref": "#/$defs/retryRecovery"},
    "rejected_admission": {"$ref": "#/$defs/rejection"},
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_root", "commit", "parent_commits", "tree", "subject_resolution", "paths"],
      "properties": {
        "repository_root": {"$ref": "#/$defs/absolutePath"},
        "commit": {"$ref": "#/$defs/commit"},
        "parent_commits": {"type": "array", "items": {"$ref": "#/$defs/commit"}},
        "tree": {"$ref": "#/$defs/sha1"},
        "subject_resolution": {"const": "exact_head_match"},
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "mode", "blob_sha1"],
            "properties": {
              "path": {"type": "string", "pattern": "^[^/].*[^/]$"},
              "mode": {"type": "string", "pattern": "^[0-7]{6}$"},
              "blob_sha1": {"$ref": "#/$defs/sha1"}
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_version", "python_implementation", "interpreter", "platform_system", "platform_release", "platform_machine", "cwd"],
      "properties": {
        "python_version": {"type": "string", "minLength": 1},
        "python_implementation": {"type": "string", "minLength": 1},
        "interpreter": {"$ref": "#/$defs/absolutePath"},
        "platform_system": {"type": "string", "minLength": 1},
        "platform_release": {"type": "string", "minLength": 1},
        "platform_machine": {"type": "string", "minLength": 1},
        "cwd": {"$ref": "#/$defs/absolutePath"}
      }
    },
    "produced_files": {
      "type": "array",
      "minItems": 10,
      "items": {"$ref": "#/$defs/fileRecord"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "absolutePath": {"type": "string", "pattern": "^(?:[A-Za-z]:[\\\\/]|/)"},
    "physicalIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "inode"],
      "properties": {"device": {"type": "string", "pattern": "^[0-9]+$"}, "inode": {"type": "string", "pattern": "^[0-9]+$"}}
    },
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "size", "raw_sha256", "git_blob_sha1"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "role": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 0},
        "raw_sha256": {"$ref": "#/$defs/sha256"},
        "git_blob_sha1": {"$ref": "#/$defs/sha1"}
      }
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "project_id", "store_identity", "control_root", "origin_authority_root", "origin_witness_path", "origin_witness_slot", "origin_witness_sha256", "foundation_sha256"],
      "properties": {
        "file": {"$ref": "#/$defs/fileRecord"},
        "project_id": {"type": "string", "minLength": 1},
        "store_identity": {"$ref": "#/$defs/sha256"},
        "control_root": {"$ref": "#/$defs/absolutePath"},
        "origin_authority_root": {"$ref": "#/$defs/absolutePath"},
        "origin_witness_path": {"$ref": "#/$defs/absolutePath"},
        "origin_witness_slot": {"$ref": "#/$defs/sha256"},
        "origin_witness_sha256": {"$ref": "#/$defs/sha256"},
        "foundation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "externalOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_status", "source_root", "source_root_state_at_restart", "source_physical_identity", "destination_root", "destination_physical_identity", "destination_manifest", "operation_evidence", "transaction", "transaction_id", "final_transaction_generation", "source_lineage"],
      "properties": {
        "operation_status": {"const": "moved_store_verified"},
        "source_root": {"$ref": "#/$defs/absolutePath"},
        "source_root_state_at_restart": {"const": "unavailable"},
        "source_physical_identity": {"$ref": "#/$defs/physicalIdentity"},
        "destination_root": {"$ref": "#/$defs/absolutePath"},
        "destination_physical_identity": {"$ref": "#/$defs/physicalIdentity"},
        "destination_manifest": {"$ref": "#/$defs/fileRecord"},
        "operation_evidence": {"$ref": "#/$defs/fileRecord"},
        "transaction": {"$ref": "#/$defs/fileRecord"},
        "transaction_id": {"$ref": "#/$defs/sha256"},
        "final_transaction_generation": {"const": 7},
        "source_lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_root", "source_root_identity", "origin_witness_path", "origin_witness_sha256"],
          "properties": {
            "source_root": {"$ref": "#/$defs/absolutePath"},
            "source_root_identity": {"$ref": "#/$defs/physicalIdentity"},
            "origin_witness_path": {"$ref": "#/$defs/absolutePath"},
            "origin_witness_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pre_writer", "locked_revalidation", "evidence_file"],
      "properties": {
        "pre_writer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "result_hash"],
          "properties": {"status": {"const": "verified"}, "result_hash": {"$ref": "#/$defs/sha256"}}
        },
        "locked_revalidation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "revalidation_sha256"],
          "properties": {"status": {"const": "verified"}, "revalidation_sha256": {"$ref": "#/$defs/sha256"}}
        },
        "evidence_file": {"$ref": "#/$defs/fileRecord"}
      }
    },
    "retryRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transaction_generations", "exact_retry", "conflicting_retry", "rollback_recovery", "evidence_file"],
      "properties": {
        "transaction_generations": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["generation", "state", "record_sha256"],
            "properties": {"generation": {"type": "integer", "minimum": 0}, "state": {"type": "string", "minLength": 1}, "record_sha256": {"$ref": "#/$defs/sha256"}}
          }
        },
        "exact_retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before_generation", "after_generation", "before_transaction_sha256", "after_transaction_sha256", "request_sha256", "result"],
          "properties": {
            "before_generation": {"const": 7},
            "after_generation": {"const": 7},
            "before_transaction_sha256": {"$ref": "#/$defs/sha256"},
            "after_transaction_sha256": {"$ref": "#/$defs/sha256"},
            "request_sha256": {"$ref": "#/$defs/sha256"},
            "result": {"const": "converged"}
          }
        },
        "conflicting_retry": {"$ref": "#/$defs/noMutation"},
        "rollback_recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["recovered_state", "transaction_generation", "transaction_sha256", "source_lineage_sha256"],
          "properties": {
            "recovered_state": {"const": "cleared"},
            "transaction_generation": {"const": 7},
            "transaction_sha256": {"$ref": "#/$defs/sha256"},
            "source_lineage_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "evidence_file": {"$ref": "#/$defs/fileRecord"}
      }
    },
    "noMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "failure_code", "snapshots", "result"],
      "properties": {
        "exit_code": {"type": "integer", "not": {"const": 0}},
        "failure_code": {"type": "string", "minLength": 1},
        "snapshots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "before_raw_sha256", "after_raw_sha256"],
            "properties": {"path": {"$ref": "#/$defs/absolutePath"}, "before_raw_sha256": {"$ref": "#/$defs/sha256"}, "after_raw_sha256": {"$ref": "#/$defs/sha256"}}
          }
        },
        "result": {"const": "rejected_without_mutation"}
      }
    },
    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "failure_code", "snapshots", "mutation_result", "evidence_file"],
      "properties": {
        "exit_code": {"type": "integer", "not": {"const": 0}},
        "failure_code": {"const": "admission_rejected"},
        "snapshots": {"$ref": "#/$defs/noMutation/properties/snapshots"},
        "mutation_result": {"const": "no_mutation"},
        "evidence_file": {"$ref": "#/$defs/fileRecord"}
      }
    }
  }
}
