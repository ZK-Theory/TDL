{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://methods/methods-pack-revisions",
  "type": "object",
  "required": ["schema_id", "schema_version", "history_id", "revisions"],
  "properties": {
    "schema_id": {"const": "ars://methods/methods-pack-revisions"},
    "schema_version": {"const": "1.0.0"},
    "history_id": {"const": "research-methods-pack-revisions"},
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/revision"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "oneOf": [{"$ref": "#/$defs/sha1"}, {"$ref": "#/$defs/sha256"}]
    },
    "revision": {
      "type": "object",
      "required": [
        "asset_id",
        "version",
        "identity_scheme",
        "identity",
        "recorded_at",
        "revision_reason",
        "supersedes_identity",
        "previous_history_blob"
      ],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^mth_[a-z0-9_]+$"},
        "version": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"},
        "identity_scheme": {"enum": ["git_blob_sha1", "lf_canonical_sha256"]},
        "identity": {"$ref": "#/$defs/identity"},
        "recorded_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "revision_reason": {"type": "string", "minLength": 20},
        "supersedes_identity": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/identity"}]
        },
        "previous_history_blob": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha1"}]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"identity_scheme": {"const": "git_blob_sha1"}}},
          "then": {"properties": {"identity": {"$ref": "#/$defs/sha1"}}}
        },
        {
          "if": {"properties": {"identity_scheme": {"const": "lf_canonical_sha256"}}},
          "then": {"properties": {"identity": {"$ref": "#/$defs/sha256"}}}
        }
      ],
      "additionalProperties": false
    }
  }
}
