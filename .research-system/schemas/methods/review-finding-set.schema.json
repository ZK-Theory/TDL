{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "ars://methods/review-finding-set", "type": "object", "additionalProperties": false,
  "required": ["document_type", "responds_to_brief_manifest_sha256", "status", "findings"],
