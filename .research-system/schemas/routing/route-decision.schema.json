{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://routing/route-decision",
  "type": "object",
  "required": ["schema_id", "schema_version", "route_decision_id", "request_id", "routing_evidence_snapshot_id", "winner_profile_id", "evaluated"],
  "properties": {
    "schema_id": {"const": "ars://routing/route-decision"},
    "schema_version": {"const": "1.0.0"},
    "route_decision_id": {"type": "string", "pattern": "^rte_"},
    "request_id": {"type": "string", "pattern": "^rrq_"},
    "routing_evidence_snapshot_id": {"type": "string", "pattern": "^res_"},
    "winner_profile_id": {"type": "string", "minLength": 1},
    "evaluated": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
