{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://wp6-2/live-issue/command/RecordLiveProviderInvocationOutcome",
  "title": "RecordLiveProviderInvocationOutcome 1.0",
  "type": "object",
  "required": [
    "schema_id", "schema_version", "command_type", "command_id", "actor_id",
    "on_behalf_of_actor_id", "authority_grant_id", "reason", "evidence_refs",
    "authority_scope", "idempotency_key", "correlation_id", "causation_id",
    "payload_hash", "target_stream_id", "invocation_id",
    "expected_invocation_stream_version", "expected_cost_grant_stream_version",
    "expected_global_position", "expected_ledger_tail_hash",
    "write_set", "claim", "invocation_evidence", "live_provider_receipt",
    "cost_grant", "reservation", "outcome", "reconciliation", "submitted_at"
  ],
  "properties": {
    "schema_id": {"const": "ars://wp6-2/live-issue/command/RecordLiveProviderInvocationOutcome"},
    "schema_version": {"const": "1.0.0"},
    "command_type": {"const": "RecordLiveProviderInvocationOutcome"},
    "command_id": {"type": "string", "pattern": "^cmd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "actor_id": {"type": "string", "pattern": "^act_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "on_behalf_of_actor_id": {"type": ["string", "null"], "pattern": "^act_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "authority_grant_id": {"type": "string", "pattern": "^agr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "reason": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/triple"}},
    "authority_scope": {"const": "wp6.2.live-issue.outcome.record"},
    "idempotency_key": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": "string", "minLength": 1},
    "payload_hash": {"$ref": "#/$defs/hash"},
    "target_stream_id": {"$ref": "#/$defs/invocation_id"},
    "invocation_id": {"$ref": "#/$defs/invocation_id"},
    "expected_invocation_stream_version": {"type": "integer", "minimum": 1},
    "expected_cost_grant_stream_version": {"type": "integer", "minimum": 1},
    "write_set": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/provider_invocation_write"},
        {"$ref": "#/$defs/cost_grant_write"}
      ],
      "items": false
    },
    "expected_global_position": {"type": "integer", "minimum": 0},
    "expected_ledger_tail_hash": {"$ref": "#/$defs/hash"},
    "claim": {"$ref": "#/$defs/triple"},
    "invocation_evidence": {"$ref": "#/$defs/triple"},
    "live_provider_receipt": {"$ref": "#/$defs/triple"},
    "cost_grant": {"$ref": "#/$defs/triple"},
    "reservation": {"$ref": "#/$defs/triple"},
    "outcome": {"enum": ["terminal", "timed_out", "cancelled", "blocked", "duplicate", "uncertain", "not_invoked"]},
    "reconciliation": {
      "type": "object",
      "required": [
        "rate_mode", "accepted_reservation", "reserved_input_tokens",
        "reserved_output_tokens", "total_token_ceiling", "input_tokens", "output_tokens", "total_tokens",
        "input_rate", "output_rate", "currency", "rate_evidence",
        "zero_cost_authority", "cost_ceiling_microunits", "reserved_cost_microunits",
        "consumed_cost_microunits", "refund_cost_microunits",
        "remaining_cost_microunits", "disposition", "actuals_proven"
      ],
      "properties": {
        "rate_mode": {"enum": ["metered", "zero_cost_authorized", "uncertain"]},
        "accepted_reservation": {"$ref": "#/$defs/reservation_authority"},
        "reserved_input_tokens": {"type": "integer", "minimum": 0},
        "reserved_output_tokens": {"type": "integer", "minimum": 0},
        "total_token_ceiling": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "input_rate": {"type": ["integer", "null"], "minimum": 0},
        "output_rate": {"type": ["integer", "null"], "minimum": 0},
        "currency": {"type": "string", "minLength": 1},
        "rate_evidence": {"$ref": "#/$defs/triple"},
        "zero_cost_authority": {"anyOf": [{"$ref": "#/$defs/triple"}, {"type": "null"}]},
        "cost_ceiling_microunits": {"type": "integer", "minimum": 0},
        "reserved_cost_microunits": {"type": "integer", "minimum": 0},
        "consumed_cost_microunits": {"type": ["integer", "null"], "minimum": 0},
        "refund_cost_microunits": {"type": ["integer", "null"], "minimum": 0},
        "remaining_cost_microunits": {"type": ["integer", "null"], "minimum": 0},
        "disposition": {"enum": ["exact", "reserved", "conservatively_consumed"]},
        "actuals_proven": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "submitted_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "invocation_id": {"type": "string", "pattern": "^pinv_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "triple": {
      "type": "object",
      "required": ["id", "revision", "hash"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": ["integer", "string"]},
        "hash": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    },
    "provider_invocation_write": {
      "type": "object", "required": ["stream_role", "stream_id", "expected_version"],
      "properties": {"stream_role": {"const": "provider_invocation"}, "stream_id": {"$ref": "#/$defs/invocation_id"}, "expected_version": {"type": "integer", "minimum": 1}},
      "additionalProperties": false
    },
    "cost_grant_write": {
      "type": "object", "required": ["stream_role", "stream_id", "expected_version"],
      "properties": {"stream_role": {"const": "cost_grant"}, "stream_id": {"type": "string", "pattern": "^cgr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "expected_version": {"type": "integer", "minimum": 1}},
      "additionalProperties": false
    },
    "reservation_authority": {
      "type": "object",
      "required": ["reservation", "rate_mode", "reserved_input_tokens", "reserved_output_tokens", "total_token_ceiling", "input_rate", "output_rate", "reserved_cost_microunits", "cost_ceiling_microunits", "pre_reconciliation_remaining_cost_microunits", "currency", "rate_evidence", "zero_cost_authority"],
      "properties": {
        "reservation": {"$ref": "#/$defs/triple"},
        "rate_mode": {"enum": ["metered", "zero_cost_authorized"]},
        "reserved_input_tokens": {"type": "integer", "minimum": 0},
        "reserved_output_tokens": {"type": "integer", "minimum": 0},
        "total_token_ceiling": {"type": "integer", "minimum": 0},
        "input_rate": {"type": "integer", "minimum": 0},
        "output_rate": {"type": "integer", "minimum": 0},
        "reserved_cost_microunits": {"type": "integer", "minimum": 0},
        "cost_ceiling_microunits": {"type": "integer", "minimum": 0},
        "pre_reconciliation_remaining_cost_microunits": {"type": "integer", "minimum": 0},
        "currency": {"type": "string", "minLength": 1},
        "rate_evidence": {"$ref": "#/$defs/triple"},
        "zero_cost_authority": {"anyOf": [{"$ref": "#/$defs/triple"}, {"type": "null"}]}
      },
      "additionalProperties": false
    }
  },
  "x-ordered-events": [
    "ProviderInvocationOutcomeRecorded",
    "LiveProviderReceiptRecorded",
    "LiveCostGrantReconciled"
  ],
  "x-semantic-validation": [
    "exact_claim_and_evidence_identity", "evidence_object_verified_before_reference",
    "actual_native_selection_matches_binding", "outcome_completeness_fail_closed",
    "integer_cost_and_refund_arithmetic", "uncertain_never_invents_actuals",
    "orphan_evidence_is_inert", "exact_replay_zero_new_effects"
  ]
}
