{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://wp6-2/live-issue/LiveIssueBinding",
  "title": "LiveIssueBinding 1.0",
  "type": "object",
  "required": [
    "schema_id", "schema_version", "live_issue_binding_id", "revision",
    "content_hash", "policy", "context", "provider_selection", "argv_profile",
    "credential_requirement", "execution", "delivery_requirement", "lifecycle"
  ],
  "properties": {
    "schema_id": {"const": "ars://wp6-2/live-issue/LiveIssueBinding"},
    "schema_version": {"const": "1.0.0"},
    "live_issue_binding_id": {"type": "string", "pattern": "^lib_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "revision": {"type": "integer", "minimum": 1},
    "content_hash": {"$ref": "#/$defs/hash"},
    "policy": {
      "type": "object",
      "required": [
        "bundle", "applicability_manifest", "compiler_id", "compiler_revision",
        "generator_id", "generator_revision", "compiled_projection_hash",
        "ordered_control_ids"
      ],
      "properties": {
        "bundle": {"$ref": "#/$defs/triple"},
        "applicability_manifest": {"$ref": "#/$defs/triple"},
        "compiler_id": {"type": "string", "minLength": 1},
        "compiler_revision": {"type": "string", "minLength": 1},
        "generator_id": {"type": "string", "minLength": 1},
        "generator_revision": {"type": "string", "minLength": 1},
        "compiled_projection_hash": {"$ref": "#/$defs/hash"},
        "ordered_control_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": [
        "packet", "addenda", "rendered_managed_content_hash",
        "input_token_gate", "reserved_output_token_gate"
      ],
      "properties": {
        "packet": {"$ref": "#/$defs/triple"},
        "addenda": {"type": "array", "items": {"$ref": "#/$defs/triple"}},
        "rendered_managed_content_hash": {"$ref": "#/$defs/hash"},
        "input_token_gate": {"$ref": "#/$defs/token_gate"},
        "reserved_output_token_gate": {"$ref": "#/$defs/token_gate"}
      },
      "additionalProperties": false
    },
    "provider_selection": {
      "type": "object",
      "required": [
        "provider_family", "native_model_selector", "native_model_version",
        "route", "profile", "reasoning_setting"
      ],
      "properties": {
        "provider_family": {"enum": ["claude", "codex"]},
        "native_model_selector": {"type": "string", "minLength": 1},
        "native_model_version": {"type": "string", "minLength": 1},
        "route": {"$ref": "#/$defs/triple"},
        "profile": {"$ref": "#/$defs/triple"},
        "reasoning_setting": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "argv_profile": {
      "type": "object",
      "required": [
        "adapter_revision", "executable", "ordered_flags", "profile_selector", "model_flag",
        "profile_flag", "reasoning_flag", "sandbox", "cwd", "root", "network",
        "tools", "permissions", "environment_allowlist", "prohibited_options"
      ],
      "properties": {
        "adapter_revision": {"type": "string", "minLength": 1},
        "executable": {"enum": ["claude", "codex"]},
        "ordered_flags": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "string", "minLength": 1}},
        "profile_selector": {"type": "string", "minLength": 1},
        "model_flag": {"type": "string", "minLength": 1},
        "profile_flag": {"type": "string", "minLength": 1},
        "reasoning_flag": {"type": "string", "minLength": 1},
        "sandbox": {"type": "string", "minLength": 1},
        "cwd": {"type": "string", "minLength": 1},
        "root": {"type": "string", "minLength": 1},
        "network": {"enum": ["denied", "provider_only"]},
        "tools": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "permissions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "environment_allowlist": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "prohibited_options": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "credential_requirement": {
      "type": "object",
      "required": [
        "secret_reference", "resolver_id", "resolver_version", "resolver_trust_root",
        "credential_class", "credential_scope", "isolated_auth_context_required",
        "expiry_revocation_rule"
      ],
      "properties": {
        "secret_reference": {"$ref": "#/$defs/triple"},
        "resolver_id": {"type": "string", "minLength": 1},
        "resolver_version": {"type": "string", "minLength": 1},
        "resolver_trust_root": {"$ref": "#/$defs/triple"},
        "credential_class": {"type": "string", "minLength": 1},
        "credential_scope": {"type": "string", "minLength": 1},
        "isolated_auth_context_required": {"const": true},
        "expiry_revocation_rule": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["timeout_ms", "cancellation", "automatic_retry", "response_protocol"],
      "properties": {
        "timeout_ms": {"type": "integer", "minimum": 1},
        "cancellation": {"type": "string", "minLength": 1},
        "automatic_retry": {"const": false},
        "response_protocol": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "delivery_requirement": {
      "type": "object",
      "required": [
        "native_id_fields", "native_status_fields", "accounting_method",
        "max_input_tokens", "max_output_tokens", "max_cost_microunits",
        "expected_payload_hash", "expected_context_hash", "proven_predicate"
      ],
      "properties": {
        "native_id_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "native_status_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "accounting_method": {"type": "string", "minLength": 1},
        "max_input_tokens": {"type": "integer", "minimum": 0},
        "max_output_tokens": {"type": "integer", "minimum": 0},
        "max_cost_microunits": {"type": "integer", "minimum": 0},
        "expected_payload_hash": {"$ref": "#/$defs/hash"},
        "expected_context_hash": {"$ref": "#/$defs/hash"},
        "proven_predicate": {"type": "string", "minLength": 20}
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": ["status", "credential_material_prohibited", "unsupported_if_native_binding_inexact"],
      "properties": {
        "status": {"const": "proposed"},
        "credential_material_prohibited": {"const": true},
        "unsupported_if_native_binding_inexact": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "triple": {
      "type": "object",
      "required": ["id", "revision", "hash"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": ["integer", "string"]},
        "hash": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    },
    "token_gate": {
      "type": "object",
      "required": ["count", "ceiling", "passed"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "ceiling": {"type": "integer", "minimum": 0},
        "passed": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "x-content-address": "sha256_RFC8785_canonical_json_excluding_content_hash",
  "x-prohibited-fields": [
    "credential_use_receipt", "credential_use_receipt_id",
    "claim_intent_hash", "provider_receipt_id", "resolver_use_evidence",
    "raw_credential", "secret_bytes", "secret_sentinel"
  ]
}
