{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://wp6-2/live-issue/event/LiveProviderInvocationClaimed",
  "title": "LiveProviderInvocationClaimed 1.0",
  "type": "object",
  "required": ["schema_id", "schema_version", "event_type", "event_id", "project_id", "stream_id", "stream_version", "prior_stream_version", "resulting_stream_version", "global_position", "transaction_id", "transaction_index", "transaction_count", "command_id", "command_type", "correlation_id", "causation_id", "actor_id", "authority_grant_id", "authority_scope", "idempotency_key", "idempotency_key_hash", "payload_hash", "occurred_at", "recorded_at", "previous_event_hash", "event_hash", "payload"],
  "properties": {
    "schema_id": {"const": "ars://wp6-2/live-issue/event/LiveProviderInvocationClaimed"},
    "schema_version": {"const": "1.0.0"},
    "event_type": {"const": "LiveProviderInvocationClaimed"},
    "event_id": {"type": "string", "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "project_id": {"type": "string", "minLength": 1},
    "stream_id": {"type": "string", "pattern": "^pinv_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "stream_version": {"const": 1},
    "prior_stream_version": {"const": 0},
    "resulting_stream_version": {"const": 1},
    "global_position": {"type": "integer", "minimum": 1},
    "transaction_id": {"type": "string", "pattern": "^txn_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "transaction_index": {"const": 0}, "transaction_count": {"const": 1},
    "command_id": {"type": "string", "pattern": "^cmd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "command_type": {"const": "ClaimLiveProviderInvocation"},
    "correlation_id": {"type": "string", "minLength": 1}, "causation_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "pattern": "^act_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "authority_grant_id": {"type": "string", "pattern": "^agr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "authority_scope": {"const": "wp6.2.live-issue.claim"},
    "idempotency_key": {"type": "string", "minLength": 1}, "idempotency_key_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "occurred_at": {"type": "string", "format": "date-time"}, "recorded_at": {"type": "string", "format": "date-time"},
    "previous_event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {
      "type": "object",
      "required": ["invocation_id", "claim_intent_hash", "live_issue_binding", "credential_use_receipt", "accepted_t2_receipt"],
      "properties": {
        "invocation_id": {"type": "string", "pattern": "^pinv_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "claim_intent_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "live_issue_binding": {"$ref": "#/$defs/triple"},
        "credential_use_receipt": {"$ref": "#/$defs/triple"},
        "accepted_t2_receipt": {"$ref": "#/$defs/triple"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {"triple": {"type": "object", "required": ["id", "revision", "hash"], "properties": {"id": {"type": "string"}, "revision": {"type": ["integer", "string"]}, "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}}
  ,"x-event-hash-domain-separator": "ars:w2:event:v1\u0000",
  "x-event-hash-preimage": "all top-level fields except event_hash with lexicographically sorted keys"
}
