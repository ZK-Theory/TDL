{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://wp6-2/live-issue/event/LiveCostGrantReconciled",
  "title": "LiveCostGrantReconciled 1.0",
  "type": "object",
  "required": ["schema_id", "schema_version", "event_type", "event_id", "stream_id", "prior_stream_version", "resulting_stream_version", "transaction_position", "command_id", "payload"],
  "properties": {
    "schema_id": {"const": "ars://wp6-2/live-issue/event/LiveCostGrantReconciled"},
    "schema_version": {"const": "1.0.0"},
    "event_type": {"const": "LiveCostGrantReconciled"},
    "event_id": {"type": "string", "pattern": "^evt_[0-9a-f-]{36}$"},
    "stream_id": {"type": "string", "pattern": "^cgr_[0-9a-f-]{36}$"},
    "prior_stream_version": {"type": "integer", "minimum": 1},
    "resulting_stream_version": {"type": "integer", "minimum": 2},
    "transaction_position": {"const": 2},
    "command_id": {"type": "string", "pattern": "^cmd_[0-9a-f-]{36}$"},
    "payload": {
      "type": "object",
      "required": ["claim", "invocation_evidence", "reservation", "rate_mode", "reserved_cost_microunits", "consumed_cost_microunits", "refund_cost_microunits", "disposition", "actuals_proven"],
      "properties": {
        "claim": {"$ref": "#/$defs/triple"},
        "invocation_evidence": {"$ref": "#/$defs/triple"},
        "reservation": {"$ref": "#/$defs/triple"},
        "rate_mode": {"enum": ["metered", "zero_cost_authorized", "uncertain"]},
        "reserved_cost_microunits": {"type": "integer", "minimum": 0},
        "consumed_cost_microunits": {"type": ["integer", "null"], "minimum": 0},
        "refund_cost_microunits": {"type": ["integer", "null"], "minimum": 0},
        "disposition": {"enum": ["exact", "reserved", "conservatively_consumed"]},
        "actuals_proven": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {"triple": {"type": "object", "required": ["id", "revision", "hash"], "properties": {"id": {"type": "string"}, "revision": {"type": ["integer", "string"]}, "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}},
  "x-semantic-validation": ["resulting_stream_version_equals_prior_plus_one", "preserve_T2_integer_cost_refund_and_post_expiry_reconciliation"]
}
