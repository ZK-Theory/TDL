{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://wp6-2/live-issue/event/LiveCostGrantReconciled",
  "title": "LiveCostGrantReconciled 1.0",
  "type": "object",
  "required": ["schema_id", "schema_version", "event_type", "event_id", "project_id", "stream_id", "stream_version", "prior_stream_version", "resulting_stream_version", "global_position", "transaction_id", "transaction_index", "transaction_count", "command_id", "command_type", "correlation_id", "causation_id", "actor_id", "authority_grant_id", "authority_scope", "idempotency_key", "idempotency_key_hash", "payload_hash", "occurred_at", "recorded_at", "previous_event_hash", "event_hash", "payload"],
  "properties": {
    "schema_id": {"const": "ars://wp6-2/live-issue/event/LiveCostGrantReconciled"},
    "schema_version": {"const": "1.0.0"},
    "event_type": {"const": "LiveCostGrantReconciled"},
    "event_id": {"type": "string", "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "project_id": {"type": "string", "minLength": 1},
    "stream_id": {"type": "string", "pattern": "^cgr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "stream_version": {"type": "integer", "minimum": 2},
    "prior_stream_version": {"type": "integer", "minimum": 1},
    "resulting_stream_version": {"type": "integer", "minimum": 2},
    "global_position": {"type": "integer", "minimum": 1},
    "transaction_id": {"type": "string", "pattern": "^txn_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "transaction_index": {"const": 2}, "transaction_count": {"const": 3},
    "command_id": {"type": "string", "pattern": "^cmd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "command_type": {"const": "RecordLiveProviderInvocationOutcome"},
    "correlation_id": {"type": "string", "minLength": 1}, "causation_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "pattern": "^act_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "authority_grant_id": {"type": "string", "pattern": "^agr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "authority_scope": {"const": "wp6.2.live-issue.outcome.record"},
    "idempotency_key": {"type": "string", "minLength": 1}, "idempotency_key_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "occurred_at": {"type": "string", "format": "date-time"}, "recorded_at": {"type": "string", "format": "date-time"},
    "previous_event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {
      "type": "object",
      "required": ["claim", "invocation_evidence", "reservation", "accepted_reservation", "rate_mode", "reserved_input_tokens", "reserved_output_tokens", "total_token_ceiling", "input_tokens", "output_tokens", "total_tokens", "input_rate", "output_rate", "currency", "rate_evidence", "zero_cost_authority", "cost_ceiling_microunits", "reserved_cost_microunits", "consumed_cost_microunits", "refund_cost_microunits", "remaining_cost_microunits", "disposition", "actuals_proven"],
      "properties": {
        "claim": {"$ref": "#/$defs/triple"},
        "invocation_evidence": {"$ref": "#/$defs/triple"},
        "reservation": {"$ref": "#/$defs/triple"},
        "accepted_reservation": {"$ref": "#/$defs/reservation_authority"},
        "rate_mode": {"enum": ["metered", "zero_cost_authorized", "uncertain"]},
        "reserved_input_tokens": {"type": "integer", "minimum": 0},
        "reserved_output_tokens": {"type": "integer", "minimum": 0},
        "total_token_ceiling": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "input_rate": {"type": ["integer", "null"], "minimum": 0},
        "output_rate": {"type": ["integer", "null"], "minimum": 0},
        "currency": {"type": "string", "minLength": 1},
        "rate_evidence": {"$ref": "#/$defs/triple"},
        "zero_cost_authority": {"anyOf": [{"$ref": "#/$defs/triple"}, {"type": "null"}]},
        "cost_ceiling_microunits": {"type": "integer", "minimum": 0},
        "reserved_cost_microunits": {"type": "integer", "minimum": 0},
        "consumed_cost_microunits": {"type": ["integer", "null"], "minimum": 0},
        "refund_cost_microunits": {"type": ["integer", "null"], "minimum": 0},
        "remaining_cost_microunits": {"type": ["integer", "null"], "minimum": 0},
        "disposition": {"enum": ["exact", "reserved", "conservatively_consumed"]},
        "actuals_proven": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "triple": {"type": "object", "required": ["id", "revision", "hash"], "properties": {"id": {"type": "string"}, "revision": {"type": ["integer", "string"]}, "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
    "reservation_authority": {
      "type": "object",
      "required": ["reservation", "reserved_cost_microunits", "cost_ceiling_microunits", "pre_reconciliation_remaining_cost_microunits", "currency", "rate_evidence"],
      "properties": {
        "reservation": {"$ref": "#/$defs/triple"},
        "reserved_cost_microunits": {"type": "integer", "minimum": 0},
        "cost_ceiling_microunits": {"type": "integer", "minimum": 0},
        "pre_reconciliation_remaining_cost_microunits": {"type": "integer", "minimum": 0},
        "currency": {"type": "string", "minLength": 1},
        "rate_evidence": {"$ref": "#/$defs/triple"}
      },
      "additionalProperties": false
    }
  },
  "x-semantic-validation": ["resulting_stream_version_equals_prior_plus_one", "preserve_T2_integer_cost_refund_and_post_expiry_reconciliation"]
}
