{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://wp6-2/live-issue/CredentialUseReceipt",
  "title": "Resolver-owned CredentialUseReceipt 1.0",
  "type": "object",
  "required": [
    "schema_id", "schema_version", "credential_use_receipt_id", "revision",
    "content_hash", "owner", "resolver", "resolver_trust_root",
    "secret_reference", "credential_class", "claim_command_id",
    "invocation_id", "claim_intent_hash", "provider_family",
    "requested_scope", "isolated_auth_context_id", "provider_process_context",
    "checked_at", "expiry_state", "revocation_state",
    "contains_credential_bytes"
  ],
  "properties": {
    "schema_id": {"const": "ars://wp6-2/live-issue/CredentialUseReceipt"},
    "schema_version": {"const": "1.0.0"},
    "credential_use_receipt_id": {"type": "string", "pattern": "^cur_[0-9a-f-]{36}$"},
    "revision": {"type": "integer", "minimum": 1},
    "content_hash": {"$ref": "#/$defs/hash"},
    "owner": {"const": "named_credential_resolver"},
    "resolver": {"$ref": "#/$defs/versioned_identity"},
    "resolver_trust_root": {"$ref": "#/$defs/triple"},
    "secret_reference": {"$ref": "#/$defs/triple"},
    "credential_class": {"type": "string", "minLength": 1},
    "claim_command_id": {"type": "string", "pattern": "^cmd_[0-9a-f-]{36}$"},
    "invocation_id": {"type": "string", "pattern": "^pinv_[0-9a-f-]{36}$"},
    "claim_intent_hash": {"$ref": "#/$defs/hash"},
    "provider_family": {"enum": ["claude", "codex"]},
    "requested_scope": {"type": "string", "minLength": 1},
    "isolated_auth_context_id": {"type": "string", "minLength": 1},
    "provider_process_context": {"type": "string", "minLength": 1},
    "checked_at": {"type": "string", "format": "date-time"},
    "expiry_state": {"const": "current"},
    "revocation_state": {"const": "not_revoked"},
    "contains_credential_bytes": {"const": false}
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "triple": {
      "type": "object",
      "required": ["id", "revision", "hash"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": ["integer", "string"]},
        "hash": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    },
    "versioned_identity": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "x-durable-owner": "configured_resolver_not_coordinator_or_adapter",
  "x-project-publication": "only_as_claim_reference_after_claim_commits"
}
