{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://wp6-2/t2/secret-reference",
  "title": "WP6.2 T2 SecretReference",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "secret_reference_id",
    "revision",
    "content_hash",
    "provider",
    "credential_class",
    "resolver_id",
    "resolver_version",
    "allowed_scope",
    "expires_at",
    "revocation_binding",
    "redaction_proof"
  ],
  "properties": {
    "schema_id": {
      "const": "ars://wp6-2/t2/secret-reference"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "secret_reference_id": {
      "type": "string",
      "pattern": "^sref_[0-9a-f-]+$"
    },
    "revision": {
      "const": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider": {
      "enum": [
        "claude",
        "codex"
      ]
    },
    "credential_class": {
      "enum": [
        "api_token",
        "oauth_session",
        "local_provider_session"
      ]
    },
    "resolver_id": {
      "type": "string",
      "minLength": 1
    },
    "resolver_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "allowed_scope": {
      "type": "object",
      "required": [
        "task_id",
        "dispatch_id",
        "attempt_id",
        "route_id",
        "profile_id",
        "adapter_revision",
        "provider_command_id",
        "provider_command_revision",
        "provider_command_hash"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^tsk_[0-9a-f-]+$"
        },
        "dispatch_id": {
          "type": "string",
          "pattern": "^dsp_[0-9a-f-]+$"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^att_[0-9a-f-]+$"
        },
        "route_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter_revision": {
          "type": "string",
          "minLength": 1
        },
        "provider_command_id": {
          "type": "string",
          "pattern": "^pcmd_[0-9a-f-]+$"
        },
        "provider_command_revision": {
          "type": "integer",
          "minimum": 1
        },
        "provider_command_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revocation_binding": {
      "type": "object",
      "required": [
        "authority_grant_id",
        "resource_grant_id",
        "new_issue_rule",
        "reconciliation_rule"
      ],
      "properties": {
        "authority_grant_id": {
          "type": "string",
          "pattern": "^agr_[0-9a-f-]+$"
        },
        "resource_grant_id": {
          "type": "string",
          "pattern": "^rgr_[0-9a-f-]+$"
        },
        "new_issue_rule": {
          "const": "require_both_current_projections_active"
        },
        "reconciliation_rule": {
          "const": "reconcile_every_previously_accepted_reservation"
        }
      },
      "additionalProperties": false
    },
    "redaction_proof": {
      "type": "object",
      "required": [
        "policy_id",
        "policy_version",
        "evidence_sha256",
        "status",
        "checked_seams"
      ],
      "properties": {
        "policy_id": {
          "const": "wp6-2-t2-secret-sentinel-policy"
        },
        "policy_version": {
          "const": "1.0.0"
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "const": "no_secret_material_observed"
        },
        "checked_seams": {
          "type": "array",
          "prefixItems": [
            {
              "const": "compiled_context_packet"
            },
            {
              "const": "generated_adapter_provider_file"
            },
            {
              "const": "rendered_provider_payload"
            },
            {
              "const": "argv_environment_config_provider_options"
            },
            {
              "const": "event_producer"
            },
            {
              "const": "receipt_producer"
            },
            {
              "const": "canonical_object_producer"
            },
            {
              "const": "fixture_evaluation_evidence_producer"
            }
          ],
          "items": false,
          "minItems": 8,
          "maxItems": 8
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
