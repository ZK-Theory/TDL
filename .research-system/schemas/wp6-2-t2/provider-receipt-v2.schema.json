    "delivery_binding": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "disposition",
            "rendered_payload_hash",
            "delivered_context_hash"
          ],
          "properties": {
            "disposition": {
              "const": "proven"
            },
            "rendered_payload_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "delivered_context_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "disposition",
            "evidence"
          ],
          "properties": {
            "disposition": {
              "const": "unable_to_prove"
            },
            "evidence": {
              "type": "object",
              "required": [
                "subject_id",
                "subject_revision",
                "subject_hash"
              ],
              "properties": {
                "subject_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "subject_revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "subject_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "timestamps": {
      "type": "object",
      "required": [
        "issued_at",
        "terminal_at"
      ],
      "properties": {
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "terminal_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "token_accounting": {
      "type": "object",
      "required": [
        "actual_input_tokens",
        "actual_output_tokens",
        "actual_total_tokens",
        "accounting_method",
        "reserved_cost_microunits",
        "consumed_cost_microunits",
        "refund_cost_microunits",
        "currency",
        "rate_evidence_id",
        "rate_evidence_revision",
        "rate_evidence_hash"
      ],
      "properties": {
        "actual_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "actual_output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "actual_total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "accounting_method": {
          "type": "string",
          "minLength": 1
        },
        "reserved_cost_microunits": {
          "type": "integer",
          "minimum": 0
        },
        "consumed_cost_microunits": {
          "type": "integer",
          "minimum": 0
        },
        "refund_cost_microunits": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "rate_evidence_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "rate_evidence_revision": {
          "type": "integer",
          "minimum": 1
        },
        "rate_evidence_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "terminal_outcome": {
      "type": "object",
      "required": [
        "status",
        "normalized_error"
      ],
      "properties": {
        "status": {
          "enum": [
            "terminal",
            "duplicate",
            "timed_out",
            "uncertain",
            "blocked"
          ]
        },
        "normalized_error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "required": [
        "references",
        "aggregate_hash"
      ],
      "properties": {
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "subject_id",
              "subject_revision",
              "subject_hash"
            ],
            "properties": {
              "subject_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "subject_revision": {
                "type": "integer",
                "minimum": 1
              },
              "subject_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "aggregate_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "lifecycle_evidence": {
      "type": "object",
      "required": [
        "retry_count",
        "duplicate_of_receipt",
        "reconciliation"
      ],
      "properties": {
        "retry_count": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_of_receipt": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "id",
                "revision",
                "content_hash"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^prcp_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "content_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "reconciliation": {
          "type": "object",
          "required": [
            "subject_id",
            "subject_revision",
            "subject_hash"
          ],
          "properties": {
            "subject_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "subject_revision": {
              "type": "integer",
              "minimum": 1
            },
            "subject_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "evidence_disposition": {
      "type": "object",
      "required": [
        "redaction",
        "omission_declarations"
      ],
      "properties": {
        "redaction": {
          "const": "secret_and_restricted_material_removed"
        },
        "omission_declarations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "completeness": {
      "type": "object",
      "required": [
        "complete",
        "reconciliation_gate_satisfied",
        "diagnostic_only"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "reconciliation_gate_satisfied": {
          "type": "boolean"
        },
        "diagnostic_only": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "completeness": {
            "properties": {
              "complete": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "delivery_binding": {
            "properties": {
              "disposition": {
                "const": "proven"
              }
            }
          },
          "completeness": {
            "properties": {
              "reconciliation_gate_satisfied": {
                "const": true
              },
              "diagnostic_only": {
                "const": false
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "completeness": {
            "properties": {
              "reconciliation_gate_satisfied": {
                "const": false
              },
              "diagnostic_only": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
