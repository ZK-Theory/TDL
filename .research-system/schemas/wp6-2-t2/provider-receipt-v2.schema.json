{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://adapters/provider-receipt/v2",
  "title": "WP6.2 T2 ProviderReceipt required-field successor",
  "x-successor-of": {
    "schema_id": "ars://adapters/provider-receipt",
    "schema_version": "1.0.0"
  },
  "x-reader-compatibility": {
    "v2_reader": "may_read_v1_for_audit_only",
    "v1_reader": "must_reject_v2",
    "t2_reconciliation": "requires_v2"
  },
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "provider_receipt_id",
    "revision",
    "revision_hash",
    "provider_command_id",
    "command_revision",
    "command_revision_hash",
    "provider",
    "model",
    "profile_id",
    "adapter_revision",
    "policy_hash",
    "context_hash",
    "rendered_payload_hash",
    "status",
    "complete",
    "t2_binding",
    "actual_consumption",
    "refund",
    "redaction"
  ],
  "properties": {
    "schema_id": {
      "const": "ars://adapters/provider-receipt/v2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "provider_receipt_id": {
      "type": "string",
      "pattern": "^prcp_[0-9a-f-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "revision_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider_command_id": {
      "type": "string",
      "pattern": "^pcmd_[0-9a-f-]+$"
    },
    "command_revision": {
      "type": "integer",
      "minimum": 1
    },
    "command_revision_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider": {
      "enum": [
        "claude",
        "codex"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter_revision": {
      "type": "string",
      "minLength": 1
    },
    "policy_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "context_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rendered_payload_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "terminal",
        "duplicate",
        "cancelled",
        "uncertain",
        "incomplete",
        "blocked"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "t2_binding": {
      "type": "object",
      "required": [
        "task_id",
        "dispatch_id",
        "attempt_id",
        "route_id",
        "secret_reference_id",
        "cost_grant_id",
        "reservation_id"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^tsk_[0-9a-f-]+$"
        },
        "dispatch_id": {
          "type": "string",
          "pattern": "^dsp_[0-9a-f-]+$"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^att_[0-9a-f-]+$"
        },
        "route_id": {
          "type": "string",
          "minLength": 1
        },
        "secret_reference_id": {
          "type": "string",
          "pattern": "^sref_[0-9a-f-]+$"
        },
        "cost_grant_id": {
          "type": "string",
          "pattern": "^cgr_[0-9a-f-]+$"
        },
        "reservation_id": {
          "type": "string",
          "pattern": "^crsv_[0-9a-f-]+$"
        }
      },
      "additionalProperties": false
    },
    "actual_consumption": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "consumed_cost_microunits"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "consumed_cost_microunits": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "refund": {
      "type": "object",
      "required": [
        "reserved_cost_microunits",
        "refund_microunits",
        "disposition"
      ],
      "properties": {
        "reserved_cost_microunits": {
          "type": "integer",
          "minimum": 0
        },
        "refund_microunits": {
          "type": "integer",
          "minimum": 0
        },
        "disposition": {
          "enum": [
            "fully_consumed",
            "refunded"
          ]
        }
      },
      "additionalProperties": false
    },
    "redaction": {
      "const": "raw_transport_content_discarded"
    }
  },
  "additionalProperties": false
}
