          "properties": {
            "id": {
              "type": "string",
              "pattern": "^crs_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "secret_reference": {
          "type": "object",
          "required": [
            "id",
            "revision",
            "content_hash"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^srf_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
