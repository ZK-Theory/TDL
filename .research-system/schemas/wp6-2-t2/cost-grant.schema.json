{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://wp6-2/t2/cost-grant",
  "title": "WP6.2 T2 CostGrant",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "cost_grant_id",
    "revision",
    "content_hash",
    "resource_grant_id",
    "resource_grant_revision",
    "resource_grant_hash",
    "authority_grant_id",
    "scope",
    "secret_reference_id",
    "secret_reference_revision",
    "secret_reference_hash",
    "provider_command_schema_id",
    "provider_command_schema_version",
    "token_ceilings",
    "cost_ceiling_microunits",
    "rate_evidence",
    "initial_accounting",
    "expires_at",
    "idempotency_identity",
    "revocation_binding"
  ],
  "properties": {
    "schema_id": {
      "const": "ars://wp6-2/t2/cost-grant"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "cost_grant_id": {
      "type": "string",
      "pattern": "^cgr_[0-9a-f-]+$"
    },
    "revision": {
      "const": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resource_grant_id": {
      "type": "string",
      "pattern": "^rgr_[0-9a-f-]+$"
    },
    "resource_grant_revision": {
      "type": "integer",
      "minimum": 1
    },
    "resource_grant_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority_grant_id": {
      "type": "string",
      "pattern": "^agr_[0-9a-f-]+$"
    },
    "scope": {
      "type": "object",
      "required": [
        "task_id",
        "dispatch_id",
        "attempt_id",
        "route_id",
        "profile_id",
        "adapter_revision",
        "provider_command_id",
        "provider_command_revision",
        "provider_command_hash"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^tsk_[0-9a-f-]+$"
        },
        "dispatch_id": {
          "type": "string",
          "pattern": "^dsp_[0-9a-f-]+$"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^att_[0-9a-f-]+$"
        },
        "route_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter_revision": {
          "type": "string",
          "minLength": 1
        },
        "provider_command_id": {
          "type": "string",
          "pattern": "^pcmd_[0-9a-f-]+$"
        },
        "provider_command_revision": {
          "type": "integer",
          "minimum": 1
        },
        "provider_command_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "secret_reference_id": {
      "type": "string",
      "pattern": "^sref_[0-9a-f-]+$"
    },
    "secret_reference_revision": {
      "type": "integer",
      "minimum": 1
    },
    "secret_reference_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider_command_schema_id": {
      "const": "ars://adapters/provider-command/v2"
    },
    "provider_command_schema_version": {
      "const": "2.0.0"
    },
    "token_ceilings": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "cost_ceiling_microunits": {
      "type": "integer",
      "minimum": 1
    },
    "rate_evidence": {
      "type": "object",
      "required": [
        "currency",
        "input_microunits_per_million_tokens",
        "output_microunits_per_million_tokens",
        "source_id",
        "source_version",
        "source_hash",
        "effective_at",
        "expires_at"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "input_microunits_per_million_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_microunits_per_million_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "initial_accounting": {
      "type": "object",
      "required": [
        "reserved_microunits",
        "consumed_microunits",
        "refunded_microunits"
      ],
      "properties": {
        "reserved_microunits": {
          "const": 0
        },
        "consumed_microunits": {
          "const": 0
        },
        "refunded_microunits": {
          "const": 0
        }
      },
      "additionalProperties": false
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_identity": {
      "type": "object",
      "required": [
        "actor_id",
        "authority_scope",
        "command_type",
        "idempotency_key"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "pattern": "^act_[0-9a-f-]+$"
        },
        "authority_scope": {
          "const": "wp6.2.t2.cost-grant.issue"
        },
        "command_type": {
          "const": "IssueCostGrant"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "revocation_binding": {
      "type": "object",
      "required": [
        "authority_grant_id",
        "resource_grant_id",
        "new_issue_rule",
        "reconciliation_rule"
      ],
      "properties": {
        "authority_grant_id": {
          "type": "string",
          "pattern": "^agr_[0-9a-f-]+$"
        },
        "resource_grant_id": {
          "type": "string",
          "pattern": "^rgr_[0-9a-f-]+$"
        },
        "new_issue_rule": {
          "const": "require_both_current_projections_active"
        },
        "reconciliation_rule": {
          "const": "reconcile_every_previously_accepted_reservation"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
