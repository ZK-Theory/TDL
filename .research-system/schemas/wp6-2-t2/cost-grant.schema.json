{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://wp6-2/t2/cost-grant",
  "title": "WP6.2 T2 CostGrant",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "cost_grant_id",
    "revision",
    "content_hash",
    "resource_grant_id",
    "resource_grant_revision",
    "resource_grant_hash",
    "authority_grant_id",
    "scope",
    "secret_reference_id",
    "secret_reference_revision",
    "secret_reference_hash",
    "provider_command_schema_id",
    "provider_command_schema_version",
    "token_ceilings",
    "cost_ceiling_microunits",
    "rate_evidence",
    "initial_accounting",
    "expires_at",
    "idempotency_identity",
    "revocation_binding"
  ],
  "properties": {
    "schema_id": {
      "const": "ars://wp6-2/t2/cost-grant"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "cost_grant_id": {
      "type": "string",
      "pattern": "^cgr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision": {
      "const": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resource_grant_id": {
      "type": "string",
      "pattern": "^rgr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "resource_grant_revision": {
      "type": "integer",
      "minimum": 1
    },
    "resource_grant_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority_grant_id": {
      "type": "string",
      "pattern": "^agr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "scope": {
      "type": "object",
      "required": [
        "task_id",
        "dispatch_id",
        "attempt_id",
        "route_id",
        "profile_id",
        "adapter_revision",
        "provider_command_id",
        "provider_command_revision",
        "provider_command_hash"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "dispatch_id": {
          "type": "string",
          "pattern": "^dsp_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^att_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "route_id": {
          "type": "string",
          "pattern": "^rte_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "profile_id": {
          "type": "string",
          "pattern": "^prf_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "adapter_revision": {
          "type": "string",
          "minLength": 1
        },
        "provider_command_id": {
          "type": "string",
          "pattern": "^pcmd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "provider_command_revision": {
          "type": "integer",
          "minimum": 1
        },
        "provider_command_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "secret_reference_id": {
      "type": "string",
      "pattern": "^srf_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "secret_reference_revision": {
      "type": "integer",
      "minimum": 1
    },
    "secret_reference_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider_command_schema_id": {
      "const": "ars://adapters/provider-command/v2"
    },
    "provider_command_schema_version": {
      "const": "2.0.0"
    },
    "token_ceilings": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "cost_ceiling_microunits": {
      "type": "integer",
      "minimum": 1
    },
    "rate_evidence": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "currency",
            "rate_evidence_id",
            "rate_evidence_revision",
            "rate_evidence_hash",
            "effective_at",
            "expires_at",
            "mode",
            "input_microunits_per_million_tokens",
            "output_microunits_per_million_tokens",
            "zero_cost_authority"
          ],
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "rate_evidence_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "rate_evidence_revision": {
              "type": "integer",
              "minimum": 1
            },
            "rate_evidence_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "effective_at": {
              "type": "string",
              "format": "date-time"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            },
            "mode": {
              "const": "metered"
            },
            "input_microunits_per_million_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "output_microunits_per_million_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "zero_cost_authority": {
              "type": "null"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "currency",
            "rate_evidence_id",
            "rate_evidence_revision",
            "rate_evidence_hash",
            "effective_at",
            "expires_at",
            "mode",
            "input_microunits_per_million_tokens",
            "output_microunits_per_million_tokens",
            "zero_cost_authority"
          ],
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "rate_evidence_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "rate_evidence_revision": {
              "type": "integer",
              "minimum": 1
            },
            "rate_evidence_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "effective_at": {
              "type": "string",
              "format": "date-time"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            },
            "mode": {
              "const": "zero_cost_authorized"
            },
            "input_microunits_per_million_tokens": {
              "const": 0
            },
            "output_microunits_per_million_tokens": {
              "const": 0
            },
            "zero_cost_authority": {
              "type": "object",
              "required": [
                "subject_id",
                "subject_revision",
                "subject_hash"
              ],
              "properties": {
                "subject_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "subject_revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "subject_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "initial_accounting": {
      "type": "object",
      "required": [
        "reserved_microunits",
        "consumed_microunits",
        "refunded_microunits"
      ],
      "properties": {
        "reserved_microunits": {
          "const": 0
        },
        "consumed_microunits": {
          "const": 0
        },
        "refunded_microunits": {
          "const": 0
        }
      },
      "additionalProperties": false
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_identity": {
      "type": "object",
      "required": [
        "actor_id",
        "authority_scope",
        "command_type",
        "idempotency_key"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "pattern": "^act_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "authority_scope": {
          "const": "wp6.2.t2.cost-grant.issue"
        },
        "command_type": {
          "const": "IssueCostGrant"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "revocation_binding": {
      "type": "object",
      "required": [
        "authority_grant_id",
        "resource_grant_id",
        "new_issue_rule",
        "reconciliation_rule"
      ],
      "properties": {
        "authority_grant_id": {
          "type": "string",
          "pattern": "^agr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "resource_grant_id": {
          "type": "string",
          "pattern": "^rgr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "new_issue_rule": {
          "const": "require_both_current_projections_active"
        },
        "reconciliation_rule": {
          "const": "reconcile_every_previously_accepted_reservation"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "x-cost-formula": "ceil_div(actual_input_tokens*input_microunits_per_million_tokens,1000000)+ceil_div(actual_output_tokens*output_microunits_per_million_tokens,1000000)"
}
