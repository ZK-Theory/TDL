{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://wp6-2/t2/event/ProviderReceiptRecorded",
  "title": "WP6.2 T2 ProviderReceiptRecorded",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "event_id",
    "event_type",
    "project_id",
    "stream_id",
    "stream_version",
    "global_position",
    "transaction_id",
    "transaction_index",
    "transaction_count",
    "command_id",
    "idempotency_key_hash",
    "payload_hash",
    "correlation_id",
    "causation_id",
    "actor_id",
    "authority_grant_id",
    "recorded_at",
    "payload",
    "previous_event_hash",
    "event_hash"
  ],
  "properties": {
    "schema_id": {
      "const": "ars://wp6-2/t2/event/ProviderReceiptRecorded"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_type": {
      "const": "ProviderReceiptRecorded"
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "stream_id": {
      "type": "string",
      "pattern": "^pcmd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "stream_version": {
      "type": "integer",
      "minimum": 1
    },
    "global_position": {
      "type": "integer",
      "minimum": 0
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^txb_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "transaction_index": {
      "const": 0
    },
    "transaction_count": {
      "const": 2
    },
    "command_id": {
      "type": "string",
      "pattern": "^cmd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "idempotency_key_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_id": {
      "type": "string",
      "pattern": "^act_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "authority_grant_id": {
      "type": "string",
      "pattern": "^agr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": [
        "provider_command_id",
        "provider_receipt_id",
        "provider_receipt_revision",
        "provider_receipt_hash",
        "cost_grant_id",
        "reservation_id",
        "provider_terminal_status",
        "receipt_complete"
      ],
      "properties": {
        "provider_command_id": {
          "type": "string",
          "pattern": "^pcmd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "provider_receipt_id": {
          "type": "string",
          "pattern": "^prcp_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "provider_receipt_revision": {
          "type": "integer",
          "minimum": 1
        },
        "provider_receipt_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cost_grant_id": {
          "type": "string",
          "pattern": "^cgr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "reservation_id": {
          "type": "string",
          "pattern": "^crs_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "provider_terminal_status": {
          "enum": [
            "terminal",
            "duplicate",
            "cancelled"
          ]
        },
        "receipt_complete": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "previous_event_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
