{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://portfolio/legacy-transition-mapping-content",
  "type": "object",
  "required": ["schema_id", "schema_version", "record_id", "record_revision", "supersedes_revision", "project_id", "portfolio_kind", "aliases", "created_at", "created_by_actor_id", "source_refs", "content_hash", "source_inventory_ref", "source_row_id", "source_row_hash", "legacy_record_observed_ref", "source_selector", "source_path", "source_bytes", "source_item_id", "source_aliases", "target_mode", "target_object_refs", "alias_mapping", "collision_scan_ref", "transition_policy_refs", "transition_relation_hash"],
  "properties": {
    "schema_id": {"const": "ars://portfolio/legacy-transition-mapping-content"}, "schema_version": {"const": "1.0.0"}, "record_id": {"$ref": "#/$defs/objId"}, "record_revision": {"type": "integer", "minimum": 1}, "supersedes_revision": {"type": ["integer", "null"], "minimum": 1}, "project_id": {"$ref": "#/$defs/projectId"}, "portfolio_kind": {"const": "legacy_transition_mapping_content"}, "aliases": {"type": "array", "items": {"$ref": "#/$defs/alias"}}, "created_at": {"type": "string", "format": "date-time"}, "created_by_actor_id": {"$ref": "#/$defs/actorId"}, "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}}, "content_hash": {"$ref": "#/$defs/sha256"},
    "source_inventory_ref": {"$ref": "#/$defs/recordRef"}, "source_row_id": {"type": "string", "minLength": 1}, "source_row_hash": {"$ref": "#/$defs/sha256"}, "legacy_record_observed_ref": {"$ref": "#/$defs/sourceRef"}, "source_selector": {"type": "string", "minLength": 1}, "source_path": {"type": "string", "minLength": 1}, "source_bytes": {"$ref": "#/$defs/sha256"}, "source_item_id": {"type": "string", "minLength": 1}, "source_aliases": {"type": "array", "items": {"$ref": "#/$defs/alias"}}, "target_mode": {"enum": ["successor_owned", "closed_reference"]}, "target_object_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/recordRef"}}, "alias_mapping": {"type": "object", "additionalProperties": {"type": "string"}}, "collision_scan_ref": {"$ref": "#/$defs/recordRef"}, "transition_policy_refs": {"$ref": "#/$defs/nonEmptyRefs"}, "transition_relation_hash": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "projectId": {"type": "string", "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "actorId": {"type": "string", "pattern": "^act_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "objId": {"type": "string", "pattern": "^obj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "nonEmptyRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/recordRef"}},
    "recordRef": {"type": "object", "required": ["id", "record_revision", "content_hash"], "properties": {"id": {"type": "string", "minLength": 1}, "record_revision": {"type": "integer", "minimum": 1}, "content_hash": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false},
    "sourceRef": {"type": "object", "required": ["ref_kind", "content_hash"], "properties": {"ref_kind": {"enum": ["record", "artefact", "external"]}, "id": {"type": "string", "minLength": 1}, "record_revision": {"type": "integer", "minimum": 1}, "locator": {"type": "string", "minLength": 1}, "content_hash": {"$ref": "#/$defs/sha256"}}, "oneOf": [{"required": ["id", "record_revision"]}, {"required": ["locator"]}], "additionalProperties": false},
    "alias": {"type": "object", "required": ["namespace", "value", "scope_id"], "properties": {"namespace": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}, "scope_id": {"type": "string", "minLength": 1}}, "additionalProperties": false}
  }
}
