{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "ars://portfolio/candidate", "type": "object",
  "required": ["schema_id", "schema_version", "record_id", "record_revision", "supersedes_revision", "project_id", "portfolio_kind", "aliases", "created_at", "created_by_actor_id", "source_refs", "content_hash", "candidate_kind", "title", "research_question", "intended_contribution", "novelty_claim", "closest_alternative_refs", "proposed_subject_refs", "data_requirements", "representation_requirements", "estimand_or_object", "falsification_value", "negative_result_value", "feasibility_evidence_refs", "resource_envelope_ref", "blocking_evidence_refs", "source_observation_refs"],
  "properties": {
    "schema_id": {"const": "ars://portfolio/candidate"}, "schema_version": {"const": "1.0.0"}, "record_id": {"$ref": "#/$defs/objId"}, "record_revision": {"type": "integer", "minimum": 1}, "supersedes_revision": {"type": ["integer", "null"], "minimum": 1}, "project_id": {"$ref": "#/$defs/projectId"}, "portfolio_kind": {"const": "candidate"}, "aliases": {"type": "array", "items": {"$ref": "#/$defs/alias"}}, "created_at": {"type": "string", "format": "date-time", "pattern": "Z$"}, "created_by_actor_id": {"$ref": "#/$defs/actorId"}, "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}}, "content_hash": {"$ref": "#/$defs/sha256"},
    "candidate_kind": {"enum": ["hypothesis", "method", "dataset", "paper", "programme_extension", "other_registered"]}, "title": {"type": "string", "minLength": 1}, "research_question": {"type": "string", "minLength": 1}, "intended_contribution": {"type": "string", "minLength": 1}, "novelty_claim": {"type": "string", "minLength": 1}, "closest_alternative_refs": {"$ref": "#/$defs/nonEmptyRefs"}, "proposed_subject_refs": {"$ref": "#/$defs/nonEmptyRefs"}, "data_requirements": {"$ref": "#/$defs/nonEmptyStrings"}, "representation_requirements": {"$ref": "#/$defs/nonEmptyStrings"}, "estimand_or_object": {"type": "string", "minLength": 1}, "falsification_value": {"type": "string", "minLength": 1}, "negative_result_value": {"type": "string", "minLength": 1}, "feasibility_evidence_refs": {"$ref": "#/$defs/nonEmptyRefs"}, "resource_envelope_ref": {"$ref": "#/$defs/recordRef"}, "blocking_evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/recordRef"}}, "source_observation_refs": {"$ref": "#/$defs/nonEmptyRefs"}
  }, "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "projectId": {"type": "string", "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "actorId": {"type": "string", "pattern": "^act_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "objId": {"type": "string", "pattern": "^obj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "nonEmptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "nonEmptyRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/recordRef"}},
    "recordRef": {"type": "object", "required": ["id", "record_revision", "content_hash"], "properties": {"id": {"type": "string", "minLength": 1}, "record_revision": {"type": "integer", "minimum": 1}, "content_hash": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false}, "sourceRef": {"type":"object","required":["ref_kind","content_hash"],"properties":{"ref_kind":{"enum":["record","artefact","external"]},"id":{"type":"string","minLength":1},"record_revision":{"type":"integer","minimum":1},"locator":{"type":"string","minLength":1},"content_hash":{"$ref":"#/$defs/sha256"}},"oneOf":[{"properties":{"ref_kind":{"enum":["record","artefact"]}},"required":["id","record_revision"],"not":{"required":["locator"]}},{"properties":{"ref_kind":{"const":"external"}},"required":["locator"],"not":{"anyOf":[{"required":["id"]},{"required":["record_revision"]}]}}],"additionalProperties":false}, "alias": {"type": "object", "required": ["namespace", "value", "scope_id"], "properties": {"namespace": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}, "scope_id": {"type": "string", "minLength": 1}}, "additionalProperties": false}
  }
}
