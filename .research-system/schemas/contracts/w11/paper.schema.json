{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "ars://portfolio/paper", "type": "object",
  "required": ["schema_id", "schema_version", "record_id", "record_revision", "supersedes_revision", "project_id", "portfolio_kind", "aliases", "created_at", "created_by_actor_id", "source_refs", "content_hash", "programme_ref", "research_question", "intended_contribution", "hypothesis_refs", "method_refs", "dataset_refs", "claim_refs", "scope_definition_refs", "manuscript_root_ref"],
  "properties": {
    "schema_id": {"const": "ars://portfolio/paper"}, "schema_version": {"const": "1.0.0"}, "record_id": {"$ref": "#/$defs/objId"}, "record_revision": {"type": "integer", "minimum": 1}, "supersedes_revision": {"type": ["integer", "null"], "minimum": 1}, "project_id": {"$ref": "#/$defs/projectId"}, "portfolio_kind": {"const": "paper"}, "aliases": {"type": "array", "items": {"$ref": "#/$defs/alias"}}, "created_at": {"type": "string", "format": "date-time", "pattern": "Z$"}, "created_by_actor_id": {"$ref": "#/$defs/actorId"}, "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}}, "content_hash": {"$ref": "#/$defs/sha256"},
    "programme_ref": {"$ref": "#/$defs/recordRef"}, "research_question": {"type": "string", "minLength": 1}, "intended_contribution": {"type": "string", "minLength": 1}, "hypothesis_refs": {"$ref": "#/$defs/nonEmptyRefs"}, "method_refs": {"$ref": "#/$defs/nonEmptyRefs"}, "dataset_refs": {"$ref": "#/$defs/nonEmptyRefs"}, "claim_refs": {"type": "array", "items": {"$ref": "#/$defs/recordRef"}}, "scope_definition_refs": {"type": "array", "items": {"$ref": "#/$defs/recordRef"}}, "manuscript_root_ref": {"$ref": "#/$defs/sourceRef"}
  }, "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "projectId": {"type": "string", "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "actorId": {"type": "string", "pattern": "^act_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "objId": {"type": "string", "pattern": "^obj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "recordRef": {"type": "object", "required": ["id", "record_revision", "content_hash"], "properties": {"id": {"type": "string", "minLength": 1}, "record_revision": {"type": "integer", "minimum": 1}, "content_hash": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false}, "sourceRef": {"type":"object","required":["ref_kind","content_hash"],"properties":{"ref_kind":{"enum":["record","artefact","external"]},"id":{"type":"string","minLength":1},"record_revision":{"type":"integer","minimum":1},"locator":{"type":"string","minLength":1},"content_hash":{"$ref":"#/$defs/sha256"}},"oneOf":[{"properties":{"ref_kind":{"enum":["record","artefact"]}},"required":["id","record_revision"],"not":{"required":["locator"]}},{"properties":{"ref_kind":{"const":"external"}},"required":["locator"],"not":{"anyOf":[{"required":["id"]},{"required":["record_revision"]}]}}],"additionalProperties":false}, "alias": {"type": "object", "required": ["namespace", "value", "scope_id"], "properties": {"namespace": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}, "scope_id": {"type": "string", "minLength": 1}}, "additionalProperties": false}, "nonEmptyRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/recordRef"}}
  }
}
