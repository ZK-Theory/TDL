{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://portfolio/legacy-record-observed",
  "type": "object",
  "required": ["schema_id", "schema_version", "observation_id", "path_registration_ref", "physical_source_identity", "complete_file_bytes_hash", "parser_id", "parser_version", "parser_hash", "source_item_selector", "source_item_id", "source_item_type", "source_aliases", "observed_row_bytes_hash", "observed_at", "non_inferences"],
  "properties": {
    "schema_id": {"const": "ars://portfolio/legacy-record-observed"},
    "schema_version": {"const": "1.0.0"},
    "observation_id": {"type": "string", "minLength": 1},
    "path_registration_ref": {"$ref": "#/$defs/recordRef"},
    "physical_source_identity": {"$ref": "#/$defs/physicalIdentity"},
    "complete_file_bytes_hash": {"$ref": "#/$defs/sha256"},
    "parser_id": {"type": "string", "minLength": 1},
    "parser_version": {"type": "string", "minLength": 1},
    "parser_hash": {"$ref": "#/$defs/sha256"},
    "source_item_selector": {"type": "string", "minLength": 1},
    "source_item_id": {"type": "string", "minLength": 1},
    "source_item_type": {"type": "string", "minLength": 1},
    "source_aliases": {"type": "array", "items": {"type": "string"}},
    "observed_row_bytes_hash": {"$ref": "#/$defs/sha256"},
    "observed_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "non_inferences": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recordRef": {
      "type": "object",
      "required": ["id", "record_revision", "content_hash"],
      "properties": {"id": {"type": "string", "minLength": 1}, "record_revision": {"type": "integer", "minimum": 1}, "content_hash": {"$ref": "#/$defs/sha256"}},
      "additionalProperties": false
    },
    "physicalIdentity": {
      "type": "object",
      "required": ["canonical_target", "reparse_chain", "volume_serial_number", "stable_file_id", "link_count", "case_aliases", "unicode_aliases", "short_name_aliases"],
      "properties": {"canonical_target": {"type": "string", "minLength": 1}, "reparse_chain": {"type": "array", "items": {"type": "string"}}, "volume_serial_number": {"type": "string", "minLength": 1}, "stable_file_id": {"type": "string", "minLength": 1}, "link_count": {"type": "integer", "minimum": 1}, "case_aliases": {"type": "array", "items": {"type": "string"}}, "unicode_aliases": {"type": "array", "items": {"type": "string"}}, "short_name_aliases": {"type": "array", "items": {"type": "string"}}},
      "additionalProperties": false
    }
  }
}
