{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://portfolio/w11-materialization-bootstrap-contract",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "source_spec",
    "materialization_status",
    "runtime_activation",
    "expected_catalogue",
    "acceptance_instance",
    "bootstrap_verifier",
    "verification_rules",
    "families",
    "forbidden"
  ],
  "properties": {
    "schema_id": {"const": "ars://portfolio/w11-materialization-bootstrap-contract"},
    "schema_version": {"const": "1.0.0"},
    "source_spec": {"$ref": "#/$defs/sourceIdentity"},
    "materialization_status": {"const": "inert_foundation_only"},
    "runtime_activation": {"const": "forbidden"},
    "expected_catalogue": {"const": "forbidden_in_pr1"},
    "acceptance_instance": {"const": "forbidden_in_pr1"},
    "bootstrap_verifier": {
      "type": "object",
      "required": [
        "schema_id",
        "schema_version",
        "interface",
        "subject_envelope",
        "external_envelope_schema_id",
        "genesis_input_schema_id",
        "execution_status"
      ],
      "properties": {
        "schema_id": {"const": "ars://portfolio/w11-bootstrap-verifier"},
        "schema_version": {"const": "1.0.0"},
        "interface": {"const": "tools.verify_w11_materialization:verify_subject_envelope"},
        "subject_envelope": {
          "type": "object",
          "required": [
            "authority",
            "required_fields",
            "path_entry_fields",
            "exact_path_set",
            "no_implicit_working_copy_or_symbolic_ref"
          ],
          "properties": {
            "authority": {"const": "caller_supplied_external"},
            "required_fields": {
              "const": ["base_commit", "subject_commit", "subject_tree", "changed_paths"]
            },
            "path_entry_fields": {"const": ["path", "blob"]},
            "exact_path_set": {"const": "git_diff_base_to_subject"},
            "no_implicit_working_copy_or_symbolic_ref": {"const": true}
          },
          "additionalProperties": false
        },
        "external_envelope_schema_id": {
          "const": "ars://portfolio/w11-catalogue-acceptance-envelope"
        },
        "genesis_input_schema_id": {
          "const": "ars://portfolio/import-accepted-w11-catalogue-genesis"
        },
        "execution_status": {"const": "schema_only_no_execution"}
      },
      "additionalProperties": false
    },
    "verification_rules": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "families": {
      "type": "object",
      "required": ["content", "relation", "artefact", "bootstrap"],
      "properties": {
        "content": {"$ref": "#/$defs/stringList"},
        "relation": {"$ref": "#/$defs/stringList"},
        "artefact": {"$ref": "#/$defs/stringList"},
        "bootstrap": {"$ref": "#/$defs/stringList"}
      },
      "additionalProperties": false
    },
    "forbidden": {"$ref": "#/$defs/stringList"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "sourceIdentity": {
      "type": "object",
      "required": ["repository_path", "reviewed_commit", "git_blob", "raw_sha256", "raw_bytes"],
      "properties": {
        "repository_path": {"type": "string", "minLength": 1},
        "reviewed_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "git_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "raw_sha256": {"$ref": "#/$defs/sha256"},
        "raw_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
