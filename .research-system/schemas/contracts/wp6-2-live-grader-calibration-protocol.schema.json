    "human_rubric": {
      "const": {
        "rubric_id": "wp6-2-human-live-grader-rubric",
        "rubric_version": "1.0.0",
        "permitted_human_authority_class": "stephen_attributed_or_explicitly_delegated_i2_human_assurance_authority",
        "minimum_blinded_graders": 2,
        "criteria": [
          "apply the accepted governing rule to the exact immutable subject and evidence",
          "reject producer self-attestation, missing attribution, and cross-class substitution",
          "preserve Partial, negative, unable_to_grade, superseded, and blocked outcomes without positive-result bias",
          "record limitations and distinguish result acceptance from claim or eligibility authority"
        ],
        "blinding": {
          "withheld_from_initial_graders": [
            "case_kind",
            "expected_decision",
            "oracle",
            "producer_identity",
            "other_grader_decisions"
          ],
          "revealed_only_to_adjudicator": [
            "case_descriptor",
            "governing_oracle",
            "initial_grader_attribution",
            "initial_disagreement_record"
          ]
        },
        "disagreement_rule": "record_each_initial_decision_and_rationale_separately_before_adjudication",
        "adjudication_rule": "a_distinct_permitted_authority_resolves_against_the_frozen_rubric_and_case_hash",
        "revision_rule": "any_rubric_change_requires_new_version_hash_full_case_rerun_independent_review_and_stephen_acceptance",
        "rubric_sha256": "75c147d7822b5c25391a0482bcac340c6d544ef43bf802b47449d30fe722e1a5"
