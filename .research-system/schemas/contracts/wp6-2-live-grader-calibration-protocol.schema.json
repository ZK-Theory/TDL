          "type": "string",
          "pattern": "^[MH]-(NEG|POS|SAF|AMB|PRO)-[FS]-[0-9]{3}-.+$"
        },
        "case_kind": {
          "enum": [
            "negative",
            "positive",
            "safe_variation",
            "ambiguous",
            "producer_correlated"
          ]
        },
        "fixture_id": {
          "type": "string",
          "pattern": "^[FS]-[0-9]{3}$"
        },
        "fixture_revision": {
          "type": "string",
          "minLength": 1
        },
        "source_fixture_tree_git_sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_reference_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "transformation_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_decision": {
          "enum": [
            "accept",
            "reject",
            "adjudication_required"
          ]
        },
        "blinding_rule": {
          "const": "withhold_case_kind_expected_decision_oracle_and_producer_identity"
        },
        "case_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  }
