{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://contracts/wp6-1-owner-source-catalogue",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "catalogue_id",
    "source_annex",
    "owner_source_annex",
    "stage1_owner_acceptance",
    "schema_identity_manifest",
    "governance",
    "normalized_row_count",
    "expanded_edge_count",
    "state_classes",
    "negative_profiles",
    "correction_selector",
    "decision_rule_evaluation_non_compensation",
    "catalogue_multiset_sha256",
    "rows"
  ],
