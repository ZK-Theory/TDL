    "schema_version": {"const": "1.0.0"},
    "catalogue_id": {"const": "wp6-1-owner-source-catalogue"},
    "source_annex": {"$ref": "#/$defs/sourceAnnex"},
    "owner_source_annex": {"$ref": "#/$defs/ownerSourceAnnex"},
    "stage1_owner_acceptance": {"$ref": "#/$defs/stage1OwnerAcceptance"},
