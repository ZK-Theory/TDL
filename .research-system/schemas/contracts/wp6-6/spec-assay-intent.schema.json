{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://portfolio/spec-assay-intent",
  "type": "object", "additionalProperties": false,
  "required": ["action", "reason"],
  "properties": {
    "action": {
      "enum": [
        "bootstrap_genesis", "bootstrap_assay_authority", "request_spec_01", "prepare_spec_01",
        "return_spec_01_complete", "review_spec_01_complete", "decide_spec_01"
      ]
    },
    "reason": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "pattern": "^obj_"},
    "reviewer_actor_id": {"type": "string", "pattern": "^act_"},
    "producer_actor_id": {"type": "string", "pattern": "^act_"},
    "recommendation": {"enum": ["PROMOTE", "PARK", "KILL"]}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "bootstrap_genesis"}}},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["candidate_id"]}, {"required": ["reviewer_actor_id"]},
            {"required": ["producer_actor_id"]}, {"required": ["recommendation"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"action": {"const": "bootstrap_assay_authority"}}},
      "then": {
        "required": ["reviewer_actor_id", "producer_actor_id"],
        "not": {"anyOf": [{"required": ["candidate_id"]}, {"required": ["recommendation"]}]}
      }
    },
    {
      "if": {
        "properties": {
          "action": {"enum": ["request_spec_01", "prepare_spec_01", "return_spec_01_complete", "review_spec_01_complete"]}
        }
      },
      "then": {
        "required": ["candidate_id"],
        "not": {
          "anyOf": [
            {"required": ["reviewer_actor_id"]}, {"required": ["producer_actor_id"]}, {"required": ["recommendation"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"action": {"const": "decide_spec_01"}}},
      "then": {
        "required": ["candidate_id", "recommendation"],
        "not": {"anyOf": [{"required": ["reviewer_actor_id"]}, {"required": ["producer_actor_id"]}]}
      }
    }
  ]
}
