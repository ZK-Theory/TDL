{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://portfolio/spec-operator-brief-package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "document_type",
    "intent",
    "recorded_at",
    "producer_actor_id",
    "causal_prefix",
    "route_id",
    "brief_source",
    "task",
    "candidate",
    "assay",
    "governed_code_subject"
  ],
  "properties": {
    "schema_id": {"const": "ars://portfolio/spec-operator-brief-package"},
    "schema_version": {"const": "1.0.0"},
    "document_type": {"const": "spec_operator_brief_package"},
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "candidate_id"],
      "properties": {
        "action": {"const": "prepare_spec_01"},
        "candidate_id": {"type": "string", "pattern": "^obj_"}
      }
    },
    "recorded_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "producer_actor_id": {"type": "string", "pattern": "^act_"},
    "causal_prefix": {"$ref": "#/$defs/causal_prefix"},
    "route_id": {"const": "SPEC-GATE6-RUN-V1"},
    "brief_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "locator", "media_type", "size_bytes", "sha256", "route_package_sha256"],
      "properties": {
        "alias": {"const": "SPEC-01"},
        "locator": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "route_package_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "task": {"$ref": "#/$defs/task"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "assay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assay_id", "request_event", "assay_bar_acceptance_sha256", "producer_relation_sha256"],
      "properties": {
        "assay_id": {"type": "string", "pattern": "^asy_"},
        "request_event": {"$ref": "#/$defs/event_ref"},
        "assay_bar_acceptance_sha256": {"$ref": "#/$defs/sha256"},
        "producer_relation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "governed_code_subject": {"$ref": "#/$defs/governed_code_subject"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event_hash", "global_position"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^evt_"},
        "event_hash": {"$ref": "#/$defs/sha256"},
        "global_position": {"type": "integer", "minimum": 1}
      }
    },
    "causal_prefix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global_position", "event_hash", "raw_prefix_sha256"],
      "properties": {
        "global_position": {"type": "integer", "minimum": 0},
        "event_hash": {"$ref": "#/$defs/sha256"},
        "raw_prefix_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_revision",
        "attempt_id",
        "dispatch_id",
        "context_packet_id",
        "code_identity",
        "environment_fingerprint"
      ],
      "properties": {
        "task_id": {"type": "string", "pattern": "^tsk_"},
        "task_revision": {"type": "integer", "minimum": 1},
        "attempt_id": {"type": "string", "pattern": "^att_"},
        "dispatch_id": {"type": "string", "pattern": "^dsp_"},
        "context_packet_id": {"type": "string", "pattern": "^ctx_"},
        "code_identity": {"type": "string", "pattern": "^git:(sha1:[0-9a-f]{40}|sha256:[0-9a-f]{64})$"},
        "environment_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "revision", "content_sha256"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^obj_"},
        "revision": {"type": "integer", "minimum": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "governed_code_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_event", "event_type", "recovery_binding_sha256", "git_head", "git_tree"],
      "properties": {
        "binding_event": {"$ref": "#/$defs/event_ref"},
        "event_type": {"enum": ["StoreBindingRepaired", "StoreBindingAdvanced"]},
        "recovery_binding_sha256": {"$ref": "#/$defs/sha256"},
        "git_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "git_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    }
  }
}
