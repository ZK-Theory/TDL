{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://portfolio/spec-project-use-intent",
  "type": "object", "additionalProperties": false,
  "required": ["action", "task_id", "reason"],
  "properties": {
    "action": {"enum": ["register_project_use_decision", "accept_project_use_decision"]},
    "task_id": {"type": "string", "pattern": "^tsk_"},
    "reason": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["retain_experimental_benchmark", "adopt_default", "reject"]},
    "rationale": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "next_gates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "subset_qualification": {"type": "string", "minLength": 1},
    "no_spike_reason": {"type": "string", "minLength": 1}
  },
  "if": {"properties": {"action": {"const": "register_project_use_decision"}}},
  "then": {"required": ["disposition", "rationale", "limitations", "next_gates", "subset_qualification"]},
  "else": {
    "not": {
      "anyOf": [
        {"required": ["disposition"]}, {"required": ["rationale"]}, {"required": ["limitations"]},
        {"required": ["next_gates"]}, {"required": ["subset_qualification"]}, {"required": ["no_spike_reason"]}
      ]
    }
  }
}
