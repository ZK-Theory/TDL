  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "required": ["alias", "root_id", "locator", "media_type", "size_bytes", "sha256", "required", "authority_class", "admitted_member"],
      "properties": {
        "alias": {"enum": ["SPEC-01", "SPEC-02"]},
        "root_id": {"const": "repository"},
        "locator": {"type": "string", "minLength": 1},
        "media_type": {"const": "text/markdown; charset=utf-8"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "required": {"const": true},
        "authority_class": {"const": "owner_decision_bound_successor"},
        "admitted_member": {"const": true}
      },
      "additionalProperties": false
