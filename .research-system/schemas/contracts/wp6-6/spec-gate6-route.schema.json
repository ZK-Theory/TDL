        "failure_outcome": {"const": "zero_publication"},
        "zero_publication_surfaces": {"const": ["events", "objects", "projections", "receipts", "indexes", "results", "claims"]},
        "duplicate_publication_count": {"const": 0},
        "corrupt_publication_count": {"const": 0}
