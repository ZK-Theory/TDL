      {"step_id": "spike_plan_authority_and_start", "stage": "spec_02_spike", "branch": "approved_entry", "owner_rows": ["OR-014", "OR-015", "OR-016", "OR-017"]},
      {"step_id": "spike_verdict_complete", "stage": "spec_02_spike", "branch": "complete", "owner_rows": ["OR-018"]},
