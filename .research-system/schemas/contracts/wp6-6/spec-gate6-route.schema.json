      {"step_id": "dossier_expected_set_authority", "stage": "authority", "branch": "always", "owner_rows": ["OR-110", "OR-111", "OR-112", "OR-113", "OR-114", "OR-115"]},
      {"step_id": "path_registration_authority", "stage": "authority", "branch": "always", "owner_rows": ["OR-116", "OR-117", "OR-118", "OR-119", "OR-120", "OR-121"]},
