      "properties": {
        "alias": {"enum": ["SPEC-01-lineage", "SPEC-02-lineage"]},
        "root_id": {"const": "optional_external_lineage"},
        "locator": {"type": "string", "minLength": 1},
        "media_type": {"const": "text/markdown; charset=utf-8"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "required": {"const": false},
        "authority_class": {"const": "lineage_only_not_current"},
        "current_authority": {"const": false},
        "admitted_member": {"const": false},
        "live_root_token": {"const": false}
      },
      "additionalProperties": false
    },
    "identitySlot": {
      "type": "object",
      "required": ["slot", "id_kind", "minting_time", "registry_check", "uniqueness", "value_in_contract"],
      "properties": {
        "slot": {"enum": ["dossier", "scope", "candidate", "assay", "spike"]},
        "id_kind": {"enum": ["object", "assay", "spike"]},
        "minting_time": {"const": "runtime_after_accepted_authority"},
        "registry_check": {"const": "absent_from_all_replayed_accepted_registries"},
        "uniqueness": {"const": "pairwise_distinct_across_route_slots"},
        "value_in_contract": {"const": null}
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": ["relation_kind", "from_slot", "to_slot", "schema_id", "status"],
      "properties": {
        "relation_kind": {"enum": ["candidate_to_assay", "assay_to_producer", "assay_to_spike", "spike_to_plan", "spike_to_attempt"]},
        "from_slot": {"type": "string", "minLength": 1},
        "to_slot": {"type": "string", "minLength": 1},
        "schema_id": {"type": "string", "pattern": "^ars://portfolio/relation/"},
        "status": {"const": "runtime_exact_hash_binding_required"}
      },
      "additionalProperties": false
    },
    "routeStep": {
      "type": "object",
      "required": ["step_id", "stage", "branch", "owner_rows"],
      "properties": {
        "step_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "stage": {"enum": ["genesis", "authority", "admission", "source_observation", "spec_01_assay", "spec_01_outcome_review", "promotion_stop", "spec_02_spike", "spec_02_outcome_review", "result_stop"]},
        "branch": {"enum": ["always", "complete", "partial", "promote_only"]},
        "owner_rows": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^OR-[0-9]{3}$"}}
      },
      "additionalProperties": false
    },
    "exclusion": {
      "type": "object",
      "required": ["owner_rows", "reason"],
      "properties": {
        "owner_rows": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^OR-[0-9]{3}$"}},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "schemaBinding": {
      "type": "object",
      "required": ["schema_id", "schema_version"],
      "properties": {
        "schema_id": {"type": "string", "pattern": "^ars://portfolio/"},
        "schema_version": {"const": "1.0.0"}
      },
      "additionalProperties": false
    }
