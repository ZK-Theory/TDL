      {"step_id": "spike_partial_review_request", "stage": "spec_02_outcome_review", "branch": "partial", "owner_rows": ["OR-037"]},
      {"step_id": "spike_partial_review", "stage": "spec_02_outcome_review", "branch": "partial", "owner_rows": ["OR-021"]},
      {"step_id": "spike_result_decision", "stage": "result_stop", "branch": "complete", "owner_rows": ["OR-026", "OR-027"]}
    ]},
    "governed_command_types": {"type": "array", "minItems": 22, "maxItems": 22, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "intentional_exclusions": {"const": [
      {"owner_rows": ["OR-001", "OR-002"], "reason": "OR-029 atomically records the real source observation and creates the Candidate; direct registration and supersession are unnecessary."},
      {"owner_rows": ["OR-008", "OR-009", "OR-010", "OR-011"], "reason": "Cancellation, revisit, and retry are outside the one-time route; partial has an honest terminal-for-now branch."},
      {"owner_rows": ["OR-022", "OR-023", "OR-024", "OR-025"], "reason": "Spike cancellation, revisit, and retry are outside the one-time route."},
      {"owner_rows": ["OR-030", "OR-031", "OR-032", "OR-033"], "reason": "Annotations and legacy ownership transition or cutover are unrelated to this route."},
      {"owner_rows": ["OR-038", "OR-039", "OR-040", "OR-041"], "reason": "Cancellation-review routes are excluded because this package does not authorize cancellation execution."},
      {"owner_rows": ["OR-109"], "reason": "Staleness recording is monitoring outside the one-time command route; entry still requires a current accepted bar."},
      {"owner_rows": ["OR-122", "OR-123", "OR-124", "OR-125", "OR-126", "OR-127", "OR-128", "OR-129", "OR-130", "OR-131", "OR-132", "OR-133", "OR-134", "OR-135", "OR-136", "OR-137", "OR-138", "OR-139"], "reason": "Legacy inventory, mapping, migration, and cutover authority are unrelated to the SPEC route."}
