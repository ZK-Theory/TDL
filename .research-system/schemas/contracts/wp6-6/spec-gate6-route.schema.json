{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://contracts/wp6-6/spec-gate6-route",
  "type": "object",
  "required": ["schema_id", "schema_version", "route_id", "package_id", "package_version", "execution_authorized", "dispatchable", "activation_status", "authority_activation", "governing_sources", "sources", "lineage_sources", "identity_slots", "relations", "stage_order", "route_steps", "governed_command_types", "intentional_exclusions", "stage_gates", "identity_resolution", "operator_exchange", "admission", "producer_authority_binding", "atomicity", "restart", "schema_bindings", "prohibitions", "assurance"],
  "properties": {
