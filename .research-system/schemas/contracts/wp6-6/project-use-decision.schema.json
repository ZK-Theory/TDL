{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://portfolio/project-use-decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "document_type",
    "intent",
    "recorded_at",
    "producer_actor_id",
    "causal_prefix",
    "task",
    "candidate",
    "assay",
    "spike",
    "decision",
    "sources",
    "evidence",
    "governed_code_subject"
  ],
  "properties": {
    "schema_id": {"const": "ars://portfolio/project-use-decision"},
    "schema_version": {"const": "1.0.0"},
    "document_type": {"const": "project_use_decision"},
    "intent": {
      "allOf": [
        {"$ref": "ars://portfolio/spec-project-use-intent"},
        {"properties": {"action": {"const": "register_project_use_decision"}}}
      ]
    },
    "recorded_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "producer_actor_id": {"type": "string", "pattern": "^act_"},
    "causal_prefix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global_position", "event_hash", "raw_prefix_sha256"],
      "properties": {
        "global_position": {"type": "integer", "minimum": 0},
        "event_hash": {"$ref": "#/$defs/sha256"},
        "raw_prefix_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "attempt_id", "acceptance_event", "selected_artefact_ids"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^tsk_"},
        "attempt_id": {"type": "string", "pattern": "^att_"},
        "acceptance_event": {"$ref": "#/$defs/event_ref"},
        "selected_artefact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^art_"}
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "revision", "content_sha256", "status"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^obj_"},
        "revision": {"type": "integer", "minimum": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["parked", "killed", "preregistration_authorized"]}
      }
    },
    "assay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assay_id", "status", "version"],
      "properties": {
        "assay_id": {"type": "string", "pattern": "^asy_"},
        "status": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "spike": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["spike_id", "status", "version"],
          "properties": {
            "spike_id": {"type": "string", "pattern": "^spk_"},
            "status": {"type": "string", "minLength": 1},
            "version": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "promotion_gate", "selected_option", "deciding_actor_id", "resolution_event"],
      "properties": {
        "decision_id": {"type": "string", "pattern": "^dec_"},
        "promotion_gate": {"enum": ["assay_to_spike", "spike_to_preregistration"]},
        "selected_option": {"enum": ["PROMOTE", "PARK", "KILL"]},
        "deciding_actor_id": {"type": "string", "pattern": "^act_"},
        "resolution_event": {"$ref": "#/$defs/event_ref"}
      }
    },
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/registration"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/registration"}},
    "governed_code_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_event", "event_type", "recovery_binding_sha256", "git_head", "git_tree"],
      "properties": {
        "binding_event": {"$ref": "#/$defs/event_ref"},
        "event_type": {"enum": ["StoreBindingRepaired", "StoreBindingAdvanced"]},
        "recovery_binding_sha256": {"$ref": "#/$defs/sha256"},
        "git_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "git_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event_hash", "global_position"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^evt_"},
        "event_hash": {"$ref": "#/$defs/sha256"},
        "global_position": {"type": "integer", "minimum": 1}
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artefact_id", "content_sha256", "event_id", "event_hash", "global_position"],
      "properties": {
        "artefact_id": {"type": "string", "pattern": "^art_"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "event_id": {"type": "string", "pattern": "^evt_"},
        "event_hash": {"$ref": "#/$defs/sha256"},
        "global_position": {"type": "integer", "minimum": 1}
      }
    }
  }
}
