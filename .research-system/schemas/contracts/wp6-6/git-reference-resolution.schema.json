{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://portfolio/git-reference-resolution",
  "type": "object",
  "required": ["repository_url", "requested_locator", "status", "resolution_trace"],
  "properties": {
    "repository_url": {"type": "string", "minLength": 1},
    "requested_locator": {"type": "string", "minLength": 1},
    "resolution_trace": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "subpath": {"type": "string", "minLength": 1}
  },
  "oneOf": [
    {"required": ["canonical_ref", "resolved_kind", "commit_oid"], "properties": {
      "status": {"const": "resolved"}, "canonical_ref": {"type": "string", "minLength": 1},
      "resolved_kind": {"enum": ["head", "tag", "commit"]}, "commit_oid": {"$ref": "#/$defs/oid"}
    }},
    {"required": ["candidates"], "properties": {
      "status": {"const": "ambiguous"}, "candidates": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/candidate"}}
    }},
    {"required": ["failure_kind"], "properties": {
      "status": {"const": "unavailable"}, "failure_kind": {"enum": ["auth", "timeout", "transport"]}
    }},
    {"properties": {"status": {"const": "absent"}, "resolution_trace": {"contains": {"type": "string", "pattern": "^exhaustive:"}}}}
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_ref", "resolved_kind", "commit_oid"],
      "properties": {
        "canonical_ref": {"type": "string", "minLength": 1},
        "resolved_kind": {"enum": ["head", "tag", "commit"]}, "commit_oid": {"$ref": "#/$defs/oid"}
      }
    }
  }
}
