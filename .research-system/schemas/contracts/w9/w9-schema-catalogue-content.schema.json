{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://legacy/w9-schema-catalogue-content",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "record_id",
    "record_revision",
    "supersedes_revision",
    "project_id",
    "created_at",
    "created_by_actor_id",
    "content_hash",
    "owner_spec_identity",
    "owner_plan_identity",
    "owner_annex_identity",
    "global_preconditions",
    "owner_row_count",
    "owner_row_range_hash",
    "schema_source_rows",
    "owner_contract_rows"
  ],
  "properties": {
    "schema_id": {
      "const": "ars://legacy/w9-schema-catalogue-content"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "$ref": "#/$defs/objId"
    },
    "record_revision": {
      "const": 1
    },
    "supersedes_revision": {
      "const": null
    },
    "project_id": {
      "$ref": "#/$defs/projectId"
    },
    "created_at": {
      "$ref": "#/$defs/utc"
    },
    "created_by_actor_id": {
      "$ref": "#/$defs/actorId"
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    },
    "owner_spec_identity": {
      "type": "object",
      "required": [
        "repository_path",
        "reviewed_commit",
        "git_blob",
        "raw_sha256",
        "raw_bytes"
      ],
      "properties": {
        "repository_path": {
          "$ref": "#/$defs/relPath"
        },
        "reviewed_commit": {
          "$ref": "#/$defs/sha1"
        },
        "git_blob": {
          "$ref": "#/$defs/sha1"
        },
        "raw_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "raw_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "owner_plan_identity": {
      "type": "object",
      "required": [
        "repository_path",
        "reviewed_commit",
        "git_blob",
        "raw_sha256",
        "raw_bytes"
      ],
      "properties": {
        "repository_path": {
          "$ref": "#/$defs/relPath"
        },
        "reviewed_commit": {
          "$ref": "#/$defs/sha1"
        },
        "git_blob": {
          "$ref": "#/$defs/sha1"
        },
        "raw_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "raw_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "owner_annex_identity": {
      "type": "object",
      "required": [
        "repository_path",
        "git_commit",
        "git_blob",
        "file_length",
        "file_sha256"
      ],
      "properties": {
        "repository_path": {
          "$ref": "#/$defs/relPath"
        },
        "git_commit": {
          "$ref": "#/$defs/sha1"
        },
        "git_blob": {
          "$ref": "#/$defs/sha1"
        },
        "file_length": {
          "type": "integer",
          "minimum": 1
        },
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "global_preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "owner_row_count": {
      "type": "integer",
      "minimum": 1
    },
    "owner_row_range_hash": {
      "$ref": "#/$defs/sha256"
    },
    "schema_source_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repository_path",
          "schema_id",
          "schema_version",
          "git_commit",
          "git_blob",
          "file_length",
          "file_sha256"
        ],
        "properties": {
          "repository_path": {
            "$ref": "#/$defs/relPath"
          },
          "schema_id": {
            "type": "string",
            "pattern": "^ars://legacy/[a-z0-9-]+$"
          },
          "schema_version": {
            "const": "1.0.0"
          },
          "git_commit": {
            "$ref": "#/$defs/sha1"
          },
          "git_blob": {
            "$ref": "#/$defs/sha1"
          },
          "file_length": {
            "type": "integer",
            "minimum": 1
          },
          "file_sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "owner_contract_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "owner_row_id",
          "command_type",
          "payload_discriminant",
          "logical_key",
          "record_schema_id",
          "record_schema_version",
          "eligible_actor",
          "requester",
          "resolver",
          "authority_subject",
          "preconditions",
          "ordered_events",
          "affected_streams",
          "complete_write_set",
          "projection_targets",
          "reducer",
          "receipt_identity",
          "binding_tests",
          "w9c_only_reason",
          "pilot_promotion_fixtures",
          "positive_test_identity",
          "negative_mutation_test_identity",
          "retry_test_identity",
          "owner_annex_ref"
        ],
        "properties": {
          "owner_row_id": {
            "type": "string",
            "pattern": "^LR-[0-9]{3}$"
          },
          "command_type": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]+$"
          },
          "payload_discriminant": {
            "type": "string",
            "pattern": "^[a-z0-9-]+(/[a-z0-9_]+)*$"
          },
          "logical_key": {
            "type": "string",
            "pattern": "^[a-z0-9-]+(/[a-z0-9_]+)*$"
          },
          "record_schema_id": {
            "type": "string",
            "pattern": "^ars://legacy/[a-z0-9-]+$"
          },
          "record_schema_version": {
            "const": "1.0.0"
          },
          "eligible_actor": {
            "enum": [
              "migration_analyst",
              "membership_author",
              "observer",
              "independent_reviewer",
              "stephen",
              "operator",
              "system_guard"
            ]
          },
          "requester": {
            "enum": [
              null,
              "migration_analyst",
              "membership_author",
              "observer",
              "independent_reviewer",
              "stephen",
              "operator",
              "system_guard"
            ]
          },
          "resolver": {
            "enum": [
              "stephen",
              "none"
            ]
          },
          "authority_subject": {
            "type": "string",
            "minLength": 1
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "ordered_events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "event",
                "multiplicity",
                "condition"
              ],
              "properties": {
                "event": {
                  "type": "string",
                  "pattern": "^(E|W2):[A-Za-z0-9-]+$"
                },
                "multiplicity": {
                  "enum": [
                    "1",
                    "0..n"
                  ]
                },
                "condition": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "multiplicity": {
                        "const": "0..n"
                      }
                    },
                    "required": [
                      "multiplicity"
                    ]
                  },
                  "then": {
                    "properties": {
                      "condition": {
                        "type": "string"
                      }
                    }
                  }
                }
              ]
            },
            "minItems": 1
          },
          "affected_streams": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "complete_write_set": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "projection_targets": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^P:[a-z0-9-]+$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "reducer": {
            "type": "string",
            "pattern": "^U:[a-z0-9-]+(, U:[a-z0-9-]+)*$"
          },
          "receipt_identity": {
            "type": "string",
            "pattern": "^R:[a-z0-9-]+(/[a-z0-9_]+)*$"
          },
          "binding_tests": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^W9-(T[0-9]+|C2[0-9])$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "w9c_only_reason": {
            "enum": [
              null,
              "authority_flow_step",
              "discharge_no_w9_test"
            ]
          },
          "pilot_promotion_fixtures": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "fixture_id",
                "when"
              ],
              "properties": {
                "fixture_id": {
                  "type": "string",
                  "pattern": "^[FS]-[0-9]{3}$"
                },
                "when": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "uniqueItems": true
          },
          "positive_test_identity": {
            "type": "string",
            "pattern": "^W9-C01-LR-[0-9]{3}$"
          },
          "negative_mutation_test_identity": {
            "type": "string",
            "pattern": "^W9-C03-LR-[0-9]{3}-owner-row-mutation$"
          },
          "retry_test_identity": {
            "type": "string",
            "pattern": "^W9-C11-LR-[0-9]{3}$"
          },
          "owner_annex_ref": {
            "type": "object",
            "required": [
              "repository_path",
              "git_commit",
              "git_blob",
              "file_sha256",
              "row_sha256"
            ],
            "properties": {
              "repository_path": {
                "$ref": "#/$defs/relPath"
              },
              "git_commit": {
                "$ref": "#/$defs/sha1"
              },
              "git_blob": {
                "$ref": "#/$defs/sha1"
              },
              "file_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "row_sha256": {
                "$ref": "#/$defs/sha256"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "w9c_only_reason": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "binding_tests": {
                  "contains": {
                    "pattern": "^W9-T"
                  }
                }
              }
            },
            "else": {
              "properties": {
                "binding_tests": {
                  "not": {
                    "contains": {
                      "pattern": "^W9-T"
                    }
                  },
                  "contains": {
                    "pattern": "^W9-C2"
                  }
                }
              }
            }
          }
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "objId": {
      "type": "string",
      "pattern": "^obj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "decId": {
      "type": "string",
      "pattern": "^dec_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revId": {
      "type": "string",
      "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "artId": {
      "type": "string",
      "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tskId": {
      "type": "string",
      "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "evtId": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "actorId": {
      "type": "string",
      "pattern": "^act_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "utcMicros": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "relPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/~])(?!.*[\\\\:])(?!.*//)(?!(.*/)?\\.\\.?(/|$))(?!.*[. ](/|$))(?!.*~[0-9])(?!.*\\s$).+$"
    },
    "recordRef": {
      "type": "object",
      "required": [
        "id",
        "record_revision",
        "content_hash"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/objId"
        },
        "record_revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "decisionRef": {
      "type": "object",
      "required": [
        "id",
        "record_revision",
        "content_hash"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/decId"
        },
        "record_revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "reviewRef": {
      "type": "object",
      "required": [
        "id",
        "record_revision",
        "content_hash"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/revId"
        },
        "record_revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "artefactRef": {
      "type": "object",
      "required": [
        "id",
        "record_revision",
        "content_hash"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/artId"
        },
        "record_revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "taskRef": {
      "type": "object",
      "required": [
        "id",
        "record_revision",
        "content_hash"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/tskId"
        },
        "record_revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "anyRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/recordRef"
        },
        {
          "$ref": "#/$defs/decisionRef"
        },
        {
          "$ref": "#/$defs/reviewRef"
        },
        {
          "$ref": "#/$defs/artefactRef"
        },
        {
          "$ref": "#/$defs/taskRef"
        }
      ]
    },
    "nullableRecordRef": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/recordRef"
        }
      ]
    },
    "nullableAnyRef": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/anyRef"
        }
      ]
    },
    "sourceLocator": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "locator_kind",
            "repository_path",
            "git_commit",
            "git_blob",
            "sha256",
            "byte_length",
            "line_span"
          ],
          "properties": {
            "locator_kind": {
              "const": "git_file"
            },
            "repository_path": {
              "allOf": [
                {
                  "$ref": "#/$defs/relPath"
                },
                {
                  "not": {
                    "pattern": "(\\.[Cc][Ss][Vv]|\\.[Pp][Kk][Ll])$"
                  }
                }
              ]
            },
            "git_commit": {
              "$ref": "#/$defs/sha1"
            },
            "git_blob": {
              "$ref": "#/$defs/sha1"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0
            },
            "line_span": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "first_line",
                    "last_line"
                  ],
                  "properties": {
                    "first_line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "last_line": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "locator_kind",
            "vault_path",
            "sha256",
            "byte_length",
            "heading_anchor"
          ],
          "properties": {
            "locator_kind": {
              "const": "vault_file"
            },
            "vault_path": {
              "allOf": [
                {
                  "allOf": [
                    {
                      "$ref": "#/$defs/relPath"
                    },
                    {
                      "not": {
                        "pattern": "(\\.[Cc][Ss][Vv]|\\.[Pp][Kk][Ll])$"
                      }
                    }
                  ]
                },
                {
                  "not": {
                    "pattern": "(^|/)[Cc][Oo][Nn][Vv][Ee][Nn][Tt][Ii][Oo][Nn][Ss]\\.[Mm][Dd]$"
                  }
                }
              ]
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0
            },
            "heading_anchor": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "sourceRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/anyRef"
        },
        {
          "$ref": "#/$defs/sourceLocator"
        }
      ]
    },
    "physicalIdentity": {
      "type": "object",
      "required": [
        "canonical_target",
        "reparse_chain",
        "volume_serial_number",
        "stable_file_id",
        "link_count",
        "case_aliases",
        "unicode_aliases",
        "short_name_aliases"
      ],
      "properties": {
        "canonical_target": {
          "type": "string",
          "minLength": 1
        },
        "reparse_chain": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "volume_serial_number": {
          "type": "string",
          "minLength": 1
        },
        "stable_file_id": {
          "type": "string",
          "minLength": 1
        },
        "link_count": {
          "type": "integer",
          "minimum": 1
        },
        "case_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unicode_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "short_name_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "sourceIdentity": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "identity_kind",
            "repository_path",
            "git_commit",
            "git_blob",
            "sha256",
            "byte_length"
          ],
          "properties": {
            "identity_kind": {
              "const": "git_tracked"
            },
            "repository_path": {
              "allOf": [
                {
                  "$ref": "#/$defs/relPath"
                },
                {
                  "not": {
                    "pattern": "(\\.[Cc][Ss][Vv]|\\.[Pp][Kk][Ll])$"
                  }
                }
              ]
            },
            "git_commit": {
              "$ref": "#/$defs/sha1"
            },
            "git_blob": {
              "$ref": "#/$defs/sha1"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "identity_kind",
            "path",
            "sha256",
            "byte_length",
            "frozen_copy_ref"
          ],
          "properties": {
            "identity_kind": {
              "const": "untracked_file"
            },
            "path": {
              "allOf": [
                {
                  "$ref": "#/$defs/relPath"
                },
                {
                  "not": {
                    "pattern": "(\\.[Cc][Ss][Vv]|\\.[Pp][Kk][Ll])$"
                  }
