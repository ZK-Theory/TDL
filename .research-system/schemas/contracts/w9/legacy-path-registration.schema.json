{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://legacy/legacy-path-registration",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "record_id",
    "record_revision",
    "supersedes_revision",
    "project_id",
    "created_at",
    "created_by_actor_id",
    "content_hash",
    "root_kind",
    "root_id",
    "normalized_path",
    "physical_identity",
    "source_identity_kind",
    "role",
    "ownership_mode",
    "writer_classes",
    "prohibited_consumers",
    "registration_decision_ref"
  ],
  "properties": {
    "schema_id": {
      "const": "ars://legacy/legacy-path-registration"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "$ref": "#/$defs/objId"
    },
    "record_revision": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "project_id": {
      "$ref": "#/$defs/projectId"
    },
    "created_at": {
      "$ref": "#/$defs/utc"
    },
    "created_by_actor_id": {
      "$ref": "#/$defs/actorId"
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    },
    "root_kind": {
      "enum": [
        "repository_root",
        "vault_root"
      ]
    },
    "root_id": {
      "type": "string",
      "minLength": 1
    },
    "normalized_path": {
      "$ref": "#/$defs/relPath"
    },
    "physical_identity": {
      "$ref": "#/$defs/physicalIdentity"
    },
    "source_identity_kind": {
      "enum": [
        "git_tracked",
        "untracked_file",
        "restricted_untracked_file",
        "vault_file"
      ]
    },
    "role": {
      "enum": [
        "legacy_research_result",
        "legacy_supersession_manifest",
        "legacy_pre_registration",
        "legacy_contract",
        "shared_enforcement_surface",
        "legacy_coordination",
        "legacy_task_log",
        "legacy_bus_file",
        "legacy_manuscript_root",
        "legacy_decision_log_entry",
        "conventions_lock",
        "successor_results_root",
        "legacy_read_only_projection"
      ]
    },
    "ownership_mode": {
      "enum": [
        "legacy_owned",
        "successor_owned",
        "closed_reference"
      ]
    },
    "writer_classes": {
      "type": "array",
      "items": {
        "enum": [
          "legacy_lane_commit",
          "repository_wide_change_with_owner_note",
          "owner_ruling",
          "ars_reviewed_pr_with_owner_note"
        ]
      },
      "uniqueItems": true
    },
    "prohibited_consumers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "registration_decision_ref": {
      "$ref": "#/$defs/recordRef"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "const": "successor_results_root"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "ownership_mode": {
            "const": "successor_owned"
          },
          "root_kind": {
            "const": "repository_root"
          },
          "normalized_path": {
            "const": "results/ars/"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "conventions_lock"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "root_kind": {
            "const": "repository_root"
          },
          "normalized_path": {
            "const": "CONVENTIONS.md"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "legacy_manuscript_root"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "root_kind": {
            "const": "repository_root"
          },
          "normalized_path": {
            "enum": [
              "papers/P01-A-JRSSA/",
              "papers/P01-B-JRSSB/"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "objId": {
      "type": "string",
      "pattern": "^obj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "actorId": {
      "type": "string",
      "pattern": "^act_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "relPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\])(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$))[^:]+$"
    },
    "recordRef": {
      "type": "object",
      "required": [
        "id",
        "record_revision",
        "content_hash"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/objId"
        },
        "record_revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "nullableRecordRef": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/recordRef"
        }
      ]
    },
    "physicalIdentity": {
      "type": "object",
      "required": [
        "canonical_target",
        "reparse_chain",
        "volume_serial_number",
        "stable_file_id",
        "link_count",
        "case_aliases",
        "unicode_aliases",
        "short_name_aliases"
      ],
      "properties": {
        "canonical_target": {
          "type": "string",
          "minLength": 1
        },
        "reparse_chain": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "volume_serial_number": {
          "type": "string",
          "minLength": 1
        },
        "stable_file_id": {
          "type": "string",
          "minLength": 1
        },
        "link_count": {
          "type": "integer",
          "minimum": 1
        },
        "case_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unicode_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "short_name_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "sourceIdentity": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "identity_kind",
            "repository_path",
            "git_commit",
            "git_blob",
            "sha256",
            "byte_length"
          ],
          "properties": {
            "identity_kind": {
              "const": "git_tracked"
            },
            "repository_path": {
              "$ref": "#/$defs/relPath"
            },
            "git_commit": {
              "$ref": "#/$defs/sha1"
            },
            "git_blob": {
              "$ref": "#/$defs/sha1"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "identity_kind",
            "path",
            "sha256",
            "byte_length",
            "frozen_copy_ref"
          ],
          "properties": {
            "identity_kind": {
              "const": "untracked_file"
            },
            "path": {
              "$ref": "#/$defs/relPath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0
            },
            "frozen_copy_ref": {
              "$ref": "#/$defs/recordRef"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "identity_kind",
            "path",
            "sha256",
            "byte_length"
          ],
          "properties": {
            "identity_kind": {
              "const": "restricted_untracked_file"
            },
            "path": {
              "$ref": "#/$defs/relPath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "identity_kind",
            "vault_path",
            "sha256",
            "byte_length",
            "frozen_copy_ref"
          ],
          "properties": {
            "identity_kind": {
              "const": "vault_file"
            },
            "vault_path": {
              "$ref": "#/$defs/relPath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0
            },
            "frozen_copy_ref": {
              "$ref": "#/$defs/recordRef"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "fileFacts": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "line_ending",
            "ends_with_terminator",
            "has_utf8_bom",
            "line_count"
          ],
          "properties": {
            "line_ending": {
              "enum": [
                "LF",
                "CRLF",
                "mixed",
                "none"
              ]
            },
            "ends_with_terminator": {
              "type": "boolean"
            },
            "has_utf8_bom": {
              "type": "boolean"
            },
            "line_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "qualifier": {
      "type": "object",
      "required": [
        "qualifier_kind",
        "source_ref",
        "text"
      ],
      "properties": {
        "qualifier_kind": {
          "enum": [
            "open_review_finding",
            "audit_verdict",
            "stale_projection_of",
            "corrected_by"
          ]
        },
        "source_ref": {
          "$ref": "#/$defs/recordRef"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
