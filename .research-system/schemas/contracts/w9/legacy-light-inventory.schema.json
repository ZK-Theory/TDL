{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://legacy/legacy-light-inventory",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "record_id",
    "record_revision",
    "supersedes_revision",
    "project_id",
    "created_at",
    "created_by_actor_id",
    "content_hash",
    "registration_ref",
    "source_identity",
    "segmentation_contract",
    "selector_kind",
    "heading_level",
    "covered_region",
    "structural_ranges",
    "suppressed_anchors",
    "file_facts",
    "read_started_at",
    "read_ended_at",
    "path_form",
    "observer_actor_id",
    "rows",
    "independent_reproduction_ref"
  ],
  "properties": {
    "schema_id": {
      "const": "ars://legacy/legacy-light-inventory"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "$ref": "#/$defs/objId"
    },
    "record_revision": {
      "const": 1
    },
    "supersedes_revision": {
      "const": null
    },
    "project_id": {
      "$ref": "#/$defs/projectId"
    },
    "created_at": {
      "$ref": "#/$defs/utc"
    },
    "created_by_actor_id": {
      "$ref": "#/$defs/actorId"
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    },
    "registration_ref": {
      "$ref": "#/$defs/recordRef"
    },
    "source_identity": {
      "$ref": "#/$defs/sourceIdentity"
    },
    "segmentation_contract": {
      "const": "w9-segmentation/1.0.0"
    },
    "selector_kind": {
      "enum": [
        "heading_section",
        "computational_log_entry",
        "tracker_task_row",
        "working_note_entry",
        "log_frontmatter",
        "conventions_unit"
      ]
    },
    "heading_level": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 6
    },
    "covered_region": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "form"
          ],
          "properties": {
            "form": {
              "const": "fixed_by_selector"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "form",
            "first_line",
            "last_line",
            "anchor_line_sha256s"
          ],
          "properties": {
            "form": {
              "const": "line_range"
            },
            "first_line": {
              "type": "integer",
              "minimum": 1
            },
            "last_line": {
              "type": "integer",
              "minimum": 1
            },
            "anchor_line_sha256s": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "form",
            "after_line",
            "after_line_sha256",
            "resolved_first_line",
            "resolved_last_line"
          ],
          "properties": {
            "form": {
              "const": "first_anchor_after"
            },
            "after_line": {
              "type": "integer",
              "minimum": 1
            },
            "after_line_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "resolved_first_line": {
              "type": "integer",
              "minimum": 1
            },
            "resolved_last_line": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "structural_ranges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "first_line",
          "last_line"
        ],
        "properties": {
          "first_line": {
            "type": "integer",
            "minimum": 1
          },
          "last_line": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "suppressed_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "line",
          "anchor_line_sha256",
          "heading_text"
        ],
        "properties": {
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "anchor_line_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "heading_text": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "file_facts": {
      "$ref": "#/$defs/fileFacts"
    },
    "read_started_at": {
      "$ref": "#/$defs/utcMicros"
    },
    "read_ended_at": {
      "$ref": "#/$defs/utcMicros"
    },
    "path_form": {
      "type": "object",
      "required": [
        "path_as_given",
        "resolved_through_link",
        "resolved_target"
      ],
      "properties": {
        "path_as_given": {
          "type": "string",
          "minLength": 1
        },
        "resolved_through_link": {
          "type": "boolean"
        },
        "resolved_target": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "observer_actor_id": {
      "$ref": "#/$defs/actorId"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "row_ordinal",
          "row_kind",
          "selector_kind",
          "anchor_text",
          "unit_hash",
          "unit_ordinal",
          "dated",
          "task_id",
          "start_byte",
          "byte_length",
          "start_line",
          "line_count",
          "raw_row_sha256",
          "anchor_line_sha256",
          "blocker_reason"
        ],
        "properties": {
          "row_ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "row_kind": {
            "enum": [
              "item",
              "blocker",
              "structural"
            ]
          },
          "selector_kind": {
            "enum": [
              "heading_section",
              "computational_log_entry",
              "tracker_task_row",
              "working_note_entry",
              "log_frontmatter",
              "conventions_unit"
            ]
          },
          "anchor_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "unit_hash": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/sha256"
              }
            ]
          },
          "unit_ordinal": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "dated": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "task_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^T[0-9]+\\.[0-9]+[a-z]*(-[a-z]+)?$"
              }
            ]
          },
          "start_byte": {
            "type": "integer",
            "minimum": 0
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "line_count": {
            "type": "integer",
            "minimum": 0
          },
          "raw_row_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "anchor_line_sha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/sha256"
              }
            ]
          },
          "blocker_reason": {
            "enum": [
              null,
              "duplicate_anchor",
              "unaddressed_region",
              "unparseable_anchor"
            ]
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "row_kind": {
                  "const": "blocker"
                }
              },
              "required": [
                "row_kind"
              ]
            },
            "then": {
              "properties": {
                "blocker_reason": {
                  "enum": [
                    "duplicate_anchor",
                    "unaddressed_region",
                    "unparseable_anchor"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "blocker_reason": {
                  "const": null
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "row_kind": {
                  "const": "item"
                }
              },
              "required": [
                "row_kind"
              ]
            },
            "then": {
              "properties": {
                "anchor_text": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "line_count": {
                  "const": 0
                }
              },
              "required": [
                "line_count"
              ]
            },
            "then": {
              "properties": {
                "row_kind": {
                  "const": "blocker"
                },
                "blocker_reason": {
                  "const": "unparseable_anchor"
                },
                "byte_length": {
                  "const": 0
                },
                "start_byte": {
                  "const": 0
                },
                "anchor_line_sha256": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "byte_length": {
                  "minimum": 1
                },
                "anchor_line_sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "selector_kind": {
                  "const": "conventions_unit"
                }
              },
              "required": [
                "selector_kind"
              ]
            },
            "then": {
              "properties": {
                "unit_hash": {
                  "$ref": "#/$defs/sha256"
                },
                "unit_ordinal": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "else": {
              "properties": {
                "unit_hash": {
                  "type": "null"
                },
                "unit_ordinal": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "selector_kind": {
                  "const": "working_note_entry"
                },
                "row_kind": {
                  "const": "item"
                }
              }
            },
            "then": {
              "properties": {
                "dated": {
                  "type": "boolean"
                }
              }
            }
          },
          {
            "if": {
              "not": {
                "properties": {
                  "selector_kind": {
                    "const": "working_note_entry"
                  }
                }
              }
            },
            "then": {
              "properties": {
                "dated": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "selector_kind": {
                  "const": "tracker_task_row"
                },
                "row_kind": {
                  "const": "item"
                }
              }
            },
            "then": {
              "properties": {
                "task_id": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "not": {
                "properties": {
                  "selector_kind": {
                    "const": "tracker_task_row"
                  }
                }
              }
            },
            "then": {
              "properties": {
                "task_id": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "independent_reproduction_ref": {
      "$ref": "#/$defs/anyRef"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "selector_kind": {
            "const": "heading_section"
          }
        },
        "required": [
          "selector_kind"
        ]
      },
      "then": {
        "properties": {
          "heading_level": {
            "type": "integer"
          },
          "covered_region": {
            "properties": {
              "form": {
                "enum": [
                  "line_range",
                  "first_anchor_after"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "heading_level": {
            "type": "null"
          },
          "structural_ranges": {
            "maxItems": 0
          },
          "suppressed_anchors": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "selector_kind": {
            "enum": [
              "tracker_task_row",
              "working_note_entry",
              "log_frontmatter",
              "conventions_unit"
            ]
          }
        },
        "required": [
          "selector_kind"
        ]
      },
      "then": {
        "properties": {
          "covered_region": {
            "properties": {
              "form": {
                "const": "fixed_by_selector"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "path_form": {
            "properties": {
              "resolved_through_link": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "path_form": {
            "properties": {
              "resolved_target": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "path_form": {
            "properties": {
              "resolved_target": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "objId": {
      "type": "string",
      "pattern": "^obj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "decId": {
      "type": "string",
      "pattern": "^dec_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revId": {
      "type": "string",
      "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "artId": {
      "type": "string",
      "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tskId": {
      "type": "string",
      "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "evtId": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "actorId": {
      "type": "string",
      "pattern": "^act_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "utcMicros": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "relPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/~])(?!.*[\\\\:])(?!.*//)(?!(.*/)?\\.\\.?(/|$))(?!.*\\s$).+$"
    },
    "recordRef": {
      "type": "object",
      "required": [
        "id",
        "record_revision",
        "content_hash"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/objId"
        },
        "record_revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "decisionRef": {
      "type": "object",
      "required": [
        "id",
        "record_revision",
        "content_hash"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/decId"
        },
        "record_revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "reviewRef": {
      "type": "object",
      "required": [
        "id",
        "record_revision",
        "content_hash"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/revId"
        },
        "record_revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "artefactRef": {
      "type": "object",
      "required": [
        "id",
        "record_revision",
        "content_hash"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/artId"
        },
        "record_revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "taskRef": {
      "type": "object",
      "required": [
        "id",
        "record_revision",
        "content_hash"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/tskId"
        },
        "record_revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "anyRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/recordRef"
        },
        {
          "$ref": "#/$defs/decisionRef"
        },
        {
          "$ref": "#/$defs/reviewRef"
        },
        {
          "$ref": "#/$defs/artefactRef"
        },
        {
          "$ref": "#/$defs/taskRef"
        }
      ]
    },
    "nullableRecordRef": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/recordRef"
        }
      ]
    },
    "nullableAnyRef": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/anyRef"
        }
      ]
    },
    "physicalIdentity": {
      "type": "object",
      "required": [
        "canonical_target",
        "reparse_chain",
        "volume_serial_number",
        "stable_file_id",
        "link_count",
        "case_aliases",
        "unicode_aliases",
        "short_name_aliases"
      ],
      "properties": {
        "canonical_target": {
          "type": "string",
          "minLength": 1
        },
        "reparse_chain": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "volume_serial_number": {
          "type": "string",
          "minLength": 1
        },
        "stable_file_id": {
          "type": "string",
          "minLength": 1
        },
        "link_count": {
          "type": "integer",
          "minimum": 1
        },
        "case_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unicode_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "short_name_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "sourceIdentity": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "identity_kind",
            "repository_path",
            "git_commit",
            "git_blob",
            "sha256",
            "byte_length"
          ],
          "properties": {
            "identity_kind": {
              "const": "git_tracked"
            },
            "repository_path": {
              "allOf": [
                {
                  "$ref": "#/$defs/relPath"
                },
                {
                  "not": {
                    "pattern": "\\.([Cc][Ss][Vv]|[Pp][Kk][Ll])$"
                  }
                }
              ]
            },
            "git_commit": {
              "$ref": "#/$defs/sha1"
            },
            "git_blob": {
              "$ref": "#/$defs/sha1"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "identity_kind",
            "path",
            "sha256",
            "byte_length",
            "frozen_copy_ref"
          ],
          "properties": {
            "identity_kind": {
              "const": "untracked_file"
            },
            "path": {
              "allOf": [
                {
                  "$ref": "#/$defs/relPath"
                },
                {
                  "not": {
                    "pattern": "\\.([Cc][Ss][Vv]|[Pp][Kk][Ll])$"
                  }
                }
              ]
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0
            },
            "frozen_copy_ref": {
              "$ref": "#/$defs/artefactRef"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "identity_kind",
            "path",
            "sha256",
            "byte_length"
          ],
          "properties": {
            "identity_kind": {
              "const": "restricted_untracked_file"
            },
            "path": {
              "$ref": "#/$defs/relPath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "identity_kind",
            "vault_path",
            "sha256",
            "byte_length",
            "frozen_copy_ref"
          ],
          "properties": {
            "identity_kind": {
              "const": "vault_file"
            },
            "vault_path": {
              "allOf": [
                {
                  "$ref": "#/$defs/relPath"
                },
                {
                  "not": {
                    "pattern": "\\.([Cc][Ss][Vv]|[Pp][Kk][Ll])$"
                  }
                }
              ]
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0
            },
            "frozen_copy_ref": {
              "$ref": "#/$defs/artefactRef"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "fileFacts": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "line_ending",
            "ends_with_terminator",
            "has_utf8_bom",
            "line_count"
          ],
          "properties": {
            "line_ending": {
              "enum": [
                "LF",
                "CRLF",
                "mixed",
                "none"
              ]
            },
            "ends_with_terminator": {
              "type": "boolean"
            },
            "has_utf8_bom": {
              "type": "boolean"
            },
            "line_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "qualifier": {
      "type": "object",
      "required": [
        "qualifier_kind",
        "source_ref",
        "text"
      ],
      "properties": {
        "qualifier_kind": {
          "enum": [
            "open_review_finding",
            "audit_verdict",
            "stale_projection_of",
            "corrected_by"
          ]
        },
        "source_ref": {
          "$ref": "#/$defs/anyRef"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
