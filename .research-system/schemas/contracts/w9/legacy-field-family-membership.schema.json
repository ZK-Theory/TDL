{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://legacy/legacy-field-family-membership",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "record_id",
    "record_revision",
    "supersedes_revision",
    "project_id",
    "created_at",
    "created_by_actor_id",
    "content_hash",
    "file_schema_id",
    "applies_to",
    "table_sha256",
    "families",
    "unassigned",
    "author_actor_id",
    "review_ref",
    "acceptance_decision_ref"
  ],
  "properties": {
    "schema_id": {
      "const": "ars://legacy/legacy-field-family-membership"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "$ref": "#/$defs/objId"
    },
    "record_revision": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "project_id": {
      "$ref": "#/$defs/projectId"
    },
    "created_at": {
      "$ref": "#/$defs/utc"
    },
    "created_by_actor_id": {
      "$ref": "#/$defs/actorId"
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    },
    "file_schema_id": {
      "type": "string",
      "minLength": 1
    },
    "applies_to": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "identity_kind",
          "git_blob",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/relPath"
          },
          "identity_kind": {
            "enum": [
              "git_tracked",
              "untracked_file",
              "restricted_untracked_file",
              "vault_file"
            ]
          },
          "git_blob": {
            "oneOf": [
              {
                "$ref": "#/$defs/sha1"
              },
              {
                "type": "null"
              }
            ]
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "if": {
          "properties": {
            "identity_kind": {
              "const": "git_tracked"
            }
          }
        },
        "then": {
          "properties": {
            "git_blob": {
              "$ref": "#/$defs/sha1"
            }
          }
        },
        "else": {
          "properties": {
            "git_blob": {
              "type": "null"
            }
          }
        }
      },
      "minItems": 1
    },
    "table_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "definition_source",
          "pointers"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "definition_source": {
            "type": "string",
            "minLength": 1
          },
          "pointers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(/([^~/]|~[01])*)*$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "unassigned": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(/([^~/]|~[01])*)*$"
      },
      "uniqueItems": true
    },
    "author_actor_id": {
      "$ref": "#/$defs/actorId"
    },
    "review_ref": {
      "$ref": "#/$defs/recordRef"
    },
    "acceptance_decision_ref": {
      "$ref": "#/$defs/recordRef"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "objId": {
      "type": "string",
      "pattern": "^obj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "actorId": {
      "type": "string",
      "pattern": "^act_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "relPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\])(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$))[^:]+$"
    },
    "recordRef": {
      "type": "object",
      "required": [
        "id",
        "record_revision",
        "content_hash"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/objId"
        },
        "record_revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "nullableRecordRef": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/recordRef"
        }
      ]
    },
    "physicalIdentity": {
      "type": "object",
      "required": [
        "canonical_target",
        "reparse_chain",
        "volume_serial_number",
        "stable_file_id",
        "link_count",
        "case_aliases",
        "unicode_aliases",
        "short_name_aliases"
      ],
      "properties": {
        "canonical_target": {
          "type": "string",
          "minLength": 1
        },
        "reparse_chain": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "volume_serial_number": {
          "type": "string",
          "minLength": 1
        },
        "stable_file_id": {
          "type": "string",
          "minLength": 1
        },
        "link_count": {
          "type": "integer",
          "minimum": 1
        },
        "case_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unicode_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "short_name_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "sourceIdentity": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "identity_kind",
            "repository_path",
            "git_commit",
            "git_blob",
            "sha256",
            "byte_length"
          ],
          "properties": {
            "identity_kind": {
              "const": "git_tracked"
            },
            "repository_path": {
              "$ref": "#/$defs/relPath"
            },
            "git_commit": {
              "$ref": "#/$defs/sha1"
            },
            "git_blob": {
              "$ref": "#/$defs/sha1"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "identity_kind",
            "path",
            "sha256",
            "byte_length",
            "frozen_copy_ref"
          ],
          "properties": {
            "identity_kind": {
              "const": "untracked_file"
            },
            "path": {
              "$ref": "#/$defs/relPath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0
            },
            "frozen_copy_ref": {
              "$ref": "#/$defs/recordRef"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "identity_kind",
            "path",
            "sha256",
            "byte_length"
          ],
          "properties": {
            "identity_kind": {
              "const": "restricted_untracked_file"
            },
            "path": {
              "$ref": "#/$defs/relPath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "identity_kind",
            "vault_path",
            "sha256",
            "byte_length",
            "frozen_copy_ref"
          ],
          "properties": {
            "identity_kind": {
              "const": "vault_file"
            },
            "vault_path": {
              "$ref": "#/$defs/relPath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0
            },
            "frozen_copy_ref": {
              "$ref": "#/$defs/recordRef"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "fileFacts": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "line_ending",
            "ends_with_terminator",
            "has_utf8_bom",
            "line_count"
          ],
          "properties": {
            "line_ending": {
              "enum": [
                "LF",
                "CRLF",
                "mixed",
                "none"
              ]
            },
            "ends_with_terminator": {
              "type": "boolean"
            },
            "has_utf8_bom": {
              "type": "boolean"
            },
            "line_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "qualifier": {
      "type": "object",
      "required": [
        "qualifier_kind",
        "source_ref",
        "text"
      ],
      "properties": {
        "qualifier_kind": {
          "enum": [
            "open_review_finding",
            "audit_verdict",
            "stale_projection_of",
            "corrected_by"
          ]
        },
        "source_ref": {
          "$ref": "#/$defs/recordRef"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
