{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"ars://core/event/OwnerAuthorityAdministrationDecisionPublished",
  "type":"object",
  "required":["event_id","event_type","schema_id","schema_version","project_id","stream_id","stream_version","global_position","transaction_id","transaction_index","transaction_count","command_id","command_type","command_schema_id","command_schema_version","command_schema_sha256","idempotency_key","command_payload_hash","correlation_id","causation_id","actor_id","authority_grant_id","occurred_at","recorded_at","payload","previous_event_hash","event_hash"],
  "properties":{
    "event_id":{"type":"string","pattern":"^evt_"},
    "event_type":{"const":"OwnerAuthorityAdministrationDecisionPublished"},
    "schema_id":{"const":"ars://core/event/OwnerAuthorityAdministrationDecisionPublished"},
    "schema_version":{"const":"1.0.0"},
    "project_id":{"type":"string","pattern":"^prj_"},
    "stream_id":{"type":"string","pattern":"^arec_"},
    "stream_version":{"const":1},
    "global_position":{"type":"integer","minimum":1},
    "transaction_id":{"type":"string","pattern":"^txb_"},
    "transaction_index":{"const":1},
    "transaction_count":{"const":1},
    "command_id":{"type":"string","pattern":"^cmd_"},
    "command_type":{"const":"PublishOwnerAuthorityAdministrationDecision"},
    "command_schema_id":{"const":"ars://core/command/PublishOwnerAuthorityAdministrationDecision"},
    "command_schema_version":{"const":"1.0.0"},
    "command_schema_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "idempotency_key":{"type":"string","minLength":1},
    "command_payload_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "correlation_id":{"type":"string","minLength":1},
    "causation_id":{"type":["string","null"]},
    "actor_id":{"type":"string","pattern":"^act_"},
    "authority_grant_id":{"type":"string","pattern":"^agr_"},
    "occurred_at":{"type":["string","null"],"format":"date-time"},
    "recorded_at":{"type":"string","format":"date-time","pattern":"Z$"},
    "payload":{
      "type":"object",
      "required":["project_id","bootstrap_manifest_sha256","root_grant_id","root_grant_sha256","authority_lane","actor_role","decision","proposed_grant"],
      "properties":{
        "project_id":{"type":"string","pattern":"^prj_"},
        "bootstrap_manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "root_grant_id":{"type":"string","pattern":"^agr_"},
        "root_grant_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "authority_lane":{"type":"string","minLength":1},
        "actor_role":{"type":"string","minLength":1},
        "decision":{"type":"object"},
        "proposed_grant":{"type":"object"}
      },
      "additionalProperties":false
    },
    "previous_event_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "event_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}
