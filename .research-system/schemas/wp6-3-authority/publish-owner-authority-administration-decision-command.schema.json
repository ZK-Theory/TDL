{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"ars://core/command/PublishOwnerAuthorityAdministrationDecision",
  "type":"object",
  "required":["command_id","command_type","schema_id","schema_version","submitted_at","actor_id","on_behalf_of_actor_id","authority_grant_id","target_stream_id","expected_stream_version","idempotency_key","correlation_id","causation_id","reason","evidence_refs","project_id","payload"],
  "properties":{
    "command_id":{"type":"string","pattern":"^cmd_"},
    "command_type":{"const":"PublishOwnerAuthorityAdministrationDecision"},
    "schema_id":{"const":"ars://core/command/PublishOwnerAuthorityAdministrationDecision"},
    "schema_version":{"const":"1.0.0"},
    "submitted_at":{"type":"string","format":"date-time","pattern":"Z$"},
    "actor_id":{"type":"string","pattern":"^act_"},
    "on_behalf_of_actor_id":{"const":null},
    "authority_grant_id":{"type":"string","pattern":"^agr_"},
    "target_stream_id":{"type":"string","pattern":"^arec_"},
    "expected_stream_version":{"const":0},
    "idempotency_key":{"type":"string","minLength":1},
    "correlation_id":{"type":"string","minLength":1},
    "causation_id":{"type":["string","null"]},
    "reason":{"type":"string","minLength":1},
    "evidence_refs":{"type":"array","items":{"type":"string","minLength":1},"minItems":1,"uniqueItems":true},
    "project_id":{"type":"string","pattern":"^prj_"},
    "payload":{
      "type":"object",
      "required":["intent"],
      "properties":{
        "intent":{
          "type":"object",
          "required":["target_actor_id","target_actor_class","authority_lane","actor_role","subject_scope","evidence_refs","effective_at","expires_at","reason","owner_action"],
          "properties":{
            "target_actor_id":{"type":"string","pattern":"^act_"},
            "target_actor_class":{"type":"string","enum":["human","agent","service"]},
            "authority_lane":{"type":"string","minLength":1},
            "actor_role":{"type":"string","minLength":1},
            "subject_scope":{"type":"object"},
            "evidence_refs":{"type":"array","items":{"type":"string","minLength":1},"minItems":1,"uniqueItems":true},
            "effective_at":{"type":"string","format":"date-time","pattern":"Z$"},
            "expires_at":{"type":"string","format":"date-time","pattern":"Z$"},
            "reason":{"type":"string","minLength":1},
            "owner_action":{"const":"activate_authority_grant"}
          },
          "additionalProperties":false
        }
      },
      "additionalProperties":false
    }
  },
  "additionalProperties":false
}
