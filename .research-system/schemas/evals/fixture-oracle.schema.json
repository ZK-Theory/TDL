{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://evals/fixture-oracle",
  "type": "object",
  "required": [
    "schema_id", "schema_version", "fixture_id", "fixture_revision",
    "oracle_kind", "assertions"
  ],
  "properties": {
    "schema_id": {"const": "ars://evals/fixture-oracle"},
    "schema_version": {"const": "1.0.0"},
    "fixture_id": {"type": "string", "pattern": "^[FS]-[0-9]{3}$"},
    "fixture_revision": {"type": "string", "minLength": 1},
    "oracle_kind": {"enum": ["pre_control", "post_control"]},
    "assertions": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "minProperties": 1}
    }
  },
  "additionalProperties": false
}
