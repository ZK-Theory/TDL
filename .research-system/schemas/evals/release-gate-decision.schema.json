{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://evals/release-gate-decision",
  "type": "object",
  "required": [
    "schema_id", "schema_version", "release_gate_decision_id",
    "coverage_manifest_id", "baseline_identity", "candidate_identity",
    "evidence_snapshot_hash", "required_verdicts", "critical_failures",
    "parity_status", "operations_status", "decision", "decided_at",
    "canonical_event_ref"
  ],
  "properties": {
    "schema_id": {"const": "ars://evals/release-gate-decision"},
    "schema_version": {"const": "1.0.0"},
    "release_gate_decision_id": {"type": "string", "minLength": 1},
    "coverage_manifest_id": {"type": "string", "minLength": 1},
    "baseline_identity": {"type": "string", "minLength": 1},
    "candidate_identity": {"type": "string", "minLength": 1},
    "evidence_snapshot_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "required_verdicts": {"type": "array", "items": {"$ref": "#/$defs/verdictEntry"}},
    "critical_failures": {"type": "array", "items": {"$ref": "#/$defs/resultKey"}},
    "parity_status": {"type": "string", "minLength": 1},
    "operations_status": {"type": "string", "minLength": 1},
    "decision": {"enum": ["pass", "fail", "blocked", "exception_limited"]},
    "decided_at": {"type": "string", "format": "date-time"},
    "canonical_event_ref": {"type": "string", "minLength": 1},
    "exception_policy_id": {"type": ["string", "null"], "minLength": 1},
    "exception_policy_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "exception_scope": {"type": ["string", "null"]},
    "exception_expiry": {"type": ["string", "null"], "format": "date-time"},
    "disabled_or_constrained_capability": {"type": ["string", "null"]},
    "rationale": {"type": ["string", "null"]},
    "human_authority_id": {"type": ["string", "null"]},
    "supersedes": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "exception_limited"}}},
      "then": {
        "required": [
          "exception_policy_id", "exception_policy_hash", "exception_scope",
          "exception_expiry", "disabled_or_constrained_capability", "human_authority_id"
        ],
        "properties": {
          "exception_policy_id": {"type": "string", "minLength": 1},
          "exception_policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "exception_scope": {"type": "string", "minLength": 1},
          "exception_expiry": {"type": "string", "format": "date-time"},
          "disabled_or_constrained_capability": {"type": "string", "minLength": 1},
          "human_authority_id": {"type": "string", "minLength": 1}
        }
      }
    }
  ],
  "$defs": {
    "resultKey": {
      "type": "array",
      "prefixItems": [
        {"type": "string"}, {"type": "string"}, {"type": "string"},
        {"enum": ["D", "T", "R", "M", "H", "O", "P"]},
        {"type": "string"}
      ],
      "minItems": 5, "maxItems": 5
    },
    "verdictEntry": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/resultKey"},
        {"type": "string", "minLength": 1}
      ],
      "minItems": 2, "maxItems": 2
    }
  },
  "additionalProperties": false
}
