{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://store/governed-code-manifest",
  "title": "Gate 6 SPEC governed-code manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "repository_identity",
    "git_commit",
    "governed_files",
    "schema_catalogue_sha256",
    "manifest_sha256"
  ],
  "properties": {
    "schema_id": {"const": "ars://store/governed-code-manifest"},
    "schema_version": {"const": "1.0.0"},
    "repository_identity": {"type": "string", "minLength": 1},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "governed_files": {
      "type": "array",
      "minItems": 5,
      "items": {"$ref": "#/$defs/governedFile"}
    },
    "schema_catalogue_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "governedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "path", "git_blob_oid", "canonical_sha256"],
      "properties": {
        "category": {
          "enum": [
            "executable_python",
            "operational_config",
            "schema",
            "contract",
            "dependency_input"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.?(/|$)).+$"
        },
        "git_blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
