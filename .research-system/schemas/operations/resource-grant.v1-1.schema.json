{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://operations/resource-grant",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "record_revision",
    "content_hash",
    "project_id",
    "resource_grant_id",
    "resource_request_id",
    "task_id",
    "dispatch_id",
    "attempt_id",
    "source_event_id",
    "source_event_hash",
    "source_command_id",
    "source_command_payload_hash",
    "resource_request_sha256",
    "authority_request_basis_sha256",
    "authority_preimage_ref",
    "authority_preimage_sha256",
    "requesting_actor_id",
    "requesting_authority_grant_id",
    "expected_control_store_position",
    "host_identity",
    "boot_identity",
    "control_store_identity",
    "store_manifest_sha256",
    "operational_profile",
    "accepted_policy_id",
    "accepted_policy_revision",
    "accepted_policy_raw_sha256",
    "renewal_policy_ref",
    "profile_constraints",
    "heartbeat_policy",
    "granted_claims",
    "granted_claims_sha256",
    "issued_at",
    "maximum_lease_duration_s",
    "expires_at",
    "revocation_conditions"
  ],
  "properties": {
    "schema_id": {"const": "ars://operations/resource-grant"},
    "schema_version": {"const": "1.1.0"},
    "record_revision": {"const": 1},
    "content_hash": {"$ref": "#/$defs/sha256"},
    "project_id": {"$ref": "#/$defs/projectId"},
    "resource_grant_id": {"$ref": "#/$defs/resourceGrantId"},
    "resource_request_id": {"$ref": "#/$defs/resourceRequestId"},
    "task_id": {"$ref": "#/$defs/taskId"},
    "dispatch_id": {"$ref": "#/$defs/dispatchId"},
    "attempt_id": {"$ref": "#/$defs/attemptId"},
    "source_event_id": {"$ref": "#/$defs/eventId"},
    "source_event_hash": {"$ref": "#/$defs/sha256"},
    "source_command_id": {"$ref": "#/$defs/commandId"},
    "source_command_payload_hash": {"$ref": "#/$defs/sha256"},
    "resource_request_sha256": {"$ref": "#/$defs/sha256"},
    "authority_request_basis_sha256": {"$ref": "#/$defs/sha256"},
    "authority_preimage_ref": {"$ref": "#/$defs/authorityPreimageRef"},
    "authority_preimage_sha256": {"$ref": "#/$defs/sha256"},
    "requesting_actor_id": {"$ref": "#/$defs/actorId"},
    "requesting_authority_grant_id": {"$ref": "#/$defs/authorityGrantId"},
    "expected_control_store_position": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "host_identity": {"$ref": "#/$defs/hostIdentity"},
    "boot_identity": {"$ref": "#/$defs/bootIdentity"},
    "control_store_identity": {"$ref": "#/$defs/sha256"},
    "store_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "operational_profile": {"enum": ["trivial", "bounded", "long_running"]},
    "accepted_policy_id": {"$ref": "#/$defs/policyId"},
    "accepted_policy_revision": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "accepted_policy_raw_sha256": {"$ref": "#/$defs/sha256"},
    "renewal_policy_ref": {"type": "string", "minLength": 1},
    "profile_constraints": {"$ref": "#/$defs/profileConstraints"},
    "heartbeat_policy": {"$ref": "#/$defs/heartbeatPolicy"},
    "granted_claims": {"type": "object", "minProperties": 1},
    "granted_claims_sha256": {"$ref": "#/$defs/sha256"},
    "issued_at": {"$ref": "#/$defs/dateTime"},
    "maximum_lease_duration_s": {"type": "integer", "minimum": 1},
    "expires_at": {"$ref": "#/$defs/dateTime"},
    "revocation_conditions": {
      "const": [
        "trusted_host_identity_changed",
        "trusted_boot_identity_changed",
        "trusted_control_store_identity_changed",
        "trusted_store_manifest_changed",
        "operational_profile_policy_changed"
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dateTime": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "projectId": {"type": "string", "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "resourceGrantId": {"type": "string", "pattern": "^rgr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "resourceRequestId": {"type": "string", "pattern": "^rsq_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "taskId": {"type": "string", "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "dispatchId": {"type": "string", "pattern": "^dsp_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "attemptId": {"type": "string", "pattern": "^att_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "eventId": {"type": "string", "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "commandId": {"type": "string", "pattern": "^cmd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "actorId": {"type": "string", "pattern": "^act_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "authorityGrantId": {"type": "string", "pattern": "^agr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "policyId": {"type": "string", "pattern": "^pol_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "hostIdentity": {"type": "string", "pattern": "^host:sha256:[0-9a-f]{64}$"},
    "bootIdentity": {"type": "string", "pattern": "^boot:sha256:[0-9a-f]{64}$"},
    "authorityPreimageRef": {"type": "string", "pattern": "^ars://operations/resource-grant-authority-preimage/sha256/[0-9a-f]{64}$"},
    "profileConstraints": {
      "type": "object",
      "required": [
        "profile_id",
        "max_runtime_s",
        "allow_child_process",
        "allow_durable_writer",
        "require_benchmark",
        "require_periodic_heartbeat",
        "require_checkpoint",
        "renewal_allowed"
      ],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "max_runtime_s": {"type": "integer", "minimum": 1},
        "allow_child_process": {"type": "boolean"},
        "allow_durable_writer": {"type": "boolean"},
        "require_benchmark": {"type": "boolean"},
        "require_periodic_heartbeat": {"type": "boolean"},
        "require_checkpoint": {"type": "boolean"},
        "renewal_allowed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "heartbeatPolicy": {
      "type": "object",
      "required": [
        "disposition",
        "cadence_seconds",
        "additional_grace_seconds",
        "stale_threshold_seconds"
      ],
      "properties": {
        "disposition": {"enum": ["required", "not_applicable"]},
        "cadence_seconds": {"type": ["integer", "null"], "minimum": 1},
        "additional_grace_seconds": {"type": ["integer", "null"], "minimum": 0},
        "stale_threshold_seconds": {"type": ["integer", "null"], "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
