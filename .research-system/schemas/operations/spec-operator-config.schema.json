{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://operations/spec-operator-config",
  "title": "SPEC Gate 6 operator configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "control_root", "project_id", "store_identity", "route_id", "operator_actor_id", "actor_session_id", "authority_grant_id"],
  "properties": {
    "schema_id": {"const": "ars://operations/spec-operator-config"},
    "schema_version": {"const": "1.0.0"},
    "control_root": {"type": "string", "minLength": 1, "pattern": "^(?:[A-Za-z]:[\\\\/]|/|\\\\\\\\)"},
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "store_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "route_id": {"const": "SPEC-GATE6-RUN-V1"},
    "operator_actor_id": {"type": "string", "pattern": "^act_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "actor_session_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "authority_grant_id": {"type": "string", "pattern": "^agr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}
  }
}
