{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://operations/spec-operator-config",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "control_root", "project_id", "store_identity", "route_id", "operator_actor_id", "actor_session_id", "authority_grant_id"],
  "properties": {
    "schema_id": {"const": "ars://operations/spec-operator-config"},
    "schema_version": {"const": "1.0.0"},
    "control_root": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "pattern": "^prj_"},
    "store_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "route_id": {"const": "SPEC-GATE6-RUN-V1"},
    "operator_actor_id": {"type": "string", "pattern": "^act_"},
    "actor_session_id": {"type": "string", "minLength": 1},
    "authority_grant_id": {"type": "string", "minLength": 1}
  }
}
