{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://operations/backup-receipt",
  "type": "object",
  "required": [
    "receipt_id", "receipt_revision", "receipt_hash", "project_id",
    "store_identity", "canonical_tail_position", "canonical_tail_hash",
    "snapshot_id", "snapshot_hash", "snapshot_source_position",
    "snapshot_source_hash", "snapshot_state_hash", "replay_start_position",
    "replay_end_position", "schema_versions", "tool_versions",
    "encryption_class", "redaction_class", "external_artefact_manifest_hash",
    "artefact_bindings", "availability_status", "availability_observation_hash",
    "created_at", "created_by_actor_id", "verified_at", "verified_by_actor_id",
    "verification_authority_grant_id", "destination_class",
    "source_endpoint_scheme", "evidence_registry_hash"
  ],
  "properties": {
    "receipt_id": {"type": "string", "minLength": 1},
    "receipt_revision": {"type": "integer", "minimum": 1},
    "receipt_hash": {"$ref": "#/$defs/sha256"},
    "project_id": {"type": "string", "pattern": "^prj_"},
    "store_identity": {"$ref": "#/$defs/sha256"},
    "canonical_tail_position": {"type": "integer", "minimum": 0},
    "canonical_tail_hash": {"$ref": "#/$defs/sha256"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "snapshot_hash": {"$ref": "#/$defs/sha256"},
    "snapshot_source_position": {"type": "integer", "minimum": 0},
    "snapshot_source_hash": {"$ref": "#/$defs/sha256"},
    "snapshot_state_hash": {"$ref": "#/$defs/sha256"},
    "replay_start_position": {"type": "integer", "minimum": 1},
    "replay_end_position": {"type": "integer", "minimum": 0},
    "schema_versions": {"$ref": "#/$defs/nonemptyStrings"},
    "tool_versions": {"$ref": "#/$defs/nonemptyStrings"},
    "encryption_class": {"type": "string", "minLength": 1},
    "redaction_class": {"type": "string", "minLength": 1},
    "external_artefact_manifest_hash": {"$ref": "#/$defs/sha256"},
    "artefact_bindings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["artefact_id", "artefact_hash"],
        "properties": {
          "artefact_id": {"type": "string", "minLength": 1},
          "artefact_hash": {"$ref": "#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    },
    "availability_status": {"const": "available"},
    "availability_observation_hash": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by_actor_id": {"type": "string", "minLength": 1},
    "verified_at": {"type": "string", "format": "date-time"},
    "verified_by_actor_id": {"type": "string", "minLength": 1},
    "verification_authority_grant_id": {"type": "string", "minLength": 1},
    "destination_class": {"type": "string", "minLength": 1},
    "source_endpoint_scheme": {"type": "string", "minLength": 1},
    "evidence_registry_hash": {"$ref": "#/$defs/sha256"},
    "evidence_registry_state_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonemptyStrings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
