{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://context/context-manifest",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "string_list": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "included": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "mandatory": {"type": "boolean"}
      },
      "required": ["source_id", "revision", "content_hash", "mandatory"]
    },
    "omission": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "reason": {"enum": ["role_irrelevant", "duplicate_content", "superseded", "budget_displaced", "unavailable", "access_denied", "policy_excluded", "privacy_excluded", "unresolved_conflict", "not_selected_by_rule", "other_typed_reason"]}
      },
      "required": ["source_id", "reason"]
    }
  },
  "properties": {
    "schema_id": {"const": "ars://context/context-manifest"},
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string", "pattern": "^ctx_"},
    "manifest_revision": {"type": "integer", "minimum": 1},
    "context_id": {"type": "string", "pattern": "^ctx_"},
    "request_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "parent_context_id": {"type": ["string", "null"]},
    "packet_object_id": {"type": "string", "pattern": "^ctx_"},
    "packet_revision": {"type": "integer", "minimum": 1},
    "rendered_packet_sha256": {"$ref": "#/$defs/sha256"},
    "project_id": {"type": "string", "pattern": "^prj_"},
    "task_id": {"type": "string", "pattern": "^tsk_"},
    "task_revision": {"type": "integer", "minimum": 1},
    "purpose": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "risk": {"enum": ["R0", "R1", "R2", "R3"]},
    "actor_id": {"type": "string", "pattern": "^act_"},
    "session_id": {"type": "string", "minLength": 1},
    "producing_attempt_id": {"type": ["string", "null"]},
    "permitted_scopes": {"$ref": "#/$defs/string_list"},
    "control_store_identity": {"type": "string", "minLength": 1},
    "source_position": {"type": "integer", "minimum": 0},
    "source_hash": {"$ref": "#/$defs/sha256"},
    "compiler_version": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "reference_profile": {"type": "string", "minLength": 1},
    "reference_token_budget": {"type": "integer", "minimum": 0},
    "reference_token_count": {"type": "integer", "minimum": 0},
    "reference_tokenizer_id": {"type": "string", "minLength": 1},
    "provider_tokenizer_id": {"type": ["string", "null"]},
    "provider_token_count": {"type": ["integer", "null"], "minimum": 0},
    "provider_upper_bound_id": {"type": ["string", "null"]},
    "provider_upper_bound_count": {"type": ["integer", "null"], "minimum": 0},
    "provider_usable_capacity": {"type": ["integer", "null"], "minimum": 0},
    "provider_reserve": {"type": ["integer", "null"], "minimum": 0},
    "utf8_bytes": {"type": "integer", "minimum": 0},
    "cumulative_addendum_bytes": {"type": "integer", "minimum": 0},
    "candidate_set_digest": {"$ref": "#/$defs/sha256"},
    "retrieval_trace_refs": {"$ref": "#/$defs/string_list"},
    "required_source_ids": {"$ref": "#/$defs/string_list"},
    "included": {"type": "array", "items": {"$ref": "#/$defs/included"}, "uniqueItems": true},
    "omissions": {"type": "array", "items": {"$ref": "#/$defs/omission"}, "uniqueItems": true},
    "conflicts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "confidence_summary": {"type": "string", "minLength": 1},
    "freshness_verdict": {"const": "current"},
    "security_declaration": {"type": "string", "minLength": 1},
    "independence_evidence_refs": {"$ref": "#/$defs/string_list"},
    "delivery_receipt_refs": {"$ref": "#/$defs/string_list"},
    "created_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "currency_triggers": {"$ref": "#/$defs/string_list"},
    "retention_class": {"type": "string", "minLength": 1},
    "sensitivity_class": {"type": "string", "minLength": 1},
    "supersession_lineage": {"$ref": "#/$defs/string_list"}
  },
  "required": ["schema_id", "schema_version", "manifest_id", "manifest_revision", "context_id", "request_id", "revision", "parent_context_id", "packet_object_id", "packet_revision", "rendered_packet_sha256", "project_id", "task_id", "task_revision", "purpose", "role", "risk", "actor_id", "session_id", "producing_attempt_id", "permitted_scopes", "control_store_identity", "source_position", "source_hash", "compiler_version", "policy_version", "reference_profile", "reference_token_budget", "reference_token_count", "reference_tokenizer_id", "provider_tokenizer_id", "provider_token_count", "provider_upper_bound_id", "provider_upper_bound_count", "provider_usable_capacity", "provider_reserve", "utf8_bytes", "cumulative_addendum_bytes", "candidate_set_digest", "retrieval_trace_refs", "required_source_ids", "included", "omissions", "conflicts", "confidence_summary", "freshness_verdict", "security_declaration", "independence_evidence_refs", "delivery_receipt_refs", "created_at", "expires_at", "currency_triggers", "retention_class", "sensitivity_class", "supersession_lineage"]
}
