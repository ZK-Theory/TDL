{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://core/command/FailContextPacket",
  "title": "W3 context lifecycle command: FailContextPacket",
  "type": "object",
  "properties": {
    "command_type": {
      "const": "FailContextPacket"
    },
    "schema_id": {
      "const": "ars://core/command/FailContextPacket"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "payload": {
      "properties": {
        "context_id": {
          "type": "string",
          "pattern": "^ctx_"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle_phase": {
          "enum": [
            "requested",
            "compiling",
            "compiled"
          ]
        },
        "failure_code": {
          "type": "string",
          "minLength": 1
        },
        "packet_evidence_status": {
          "enum": [
            "absent_before_immutable_bytes",
            "present"
          ]
        },
        "packet_revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "packet_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id",
        "request_id",
        "lifecycle_phase",
        "failure_code",
        "packet_evidence_status",
        "packet_revision",
        "packet_sha256"
      ],
      "allOf": [
        {
          "if": {"properties": {"lifecycle_phase": {"const": "compiled"}}},
          "then": {
            "properties": {
              "packet_evidence_status": {"const": "present"},
              "packet_revision": {"type": "integer"},
              "packet_sha256": {"type": "string"}
            }
          },
          "else": {
            "properties": {
              "packet_evidence_status": {"const": "absent_before_immutable_bytes"},
              "packet_revision": {"type": "null"},
              "packet_sha256": {"type": "null"}
            }
          }
        }
      ]
    }
  },
  "required": [
    "command_type",
    "schema_id",
    "schema_version",
    "payload"
  ]
}
