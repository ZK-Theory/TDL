{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://core/command/BeginContextCompilation",
  "title": "W3 context lifecycle command: BeginContextCompilation",
  "type": "object",
  "properties": {
    "command_id": {
      "type": "string",
      "pattern": "^cmd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^act_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "on_behalf_of_actor_id": {
      "type": ["string", "null"],
      "pattern": "^act_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "authority_grant_id": {
      "type": "string",
      "pattern": "^agr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "target_stream_id": {
      "type": "string",
      "pattern": "^ctx_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "expected_stream_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "command_type": {
      "const": "BeginContextCompilation"
    },
    "schema_id": {
      "const": "ars://core/command/BeginContextCompilation"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "payload": {
      "properties": {
        "context_id": {
          "type": "string",
          "pattern": "^ctx_"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "compiler_version": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id",
        "request_id",
        "revision",
        "compiler_version",
        "policy_version"
      ]
    }
  },
  "required": [
    "command_id",
    "command_type",
    "schema_id",
    "schema_version",
    "submitted_at",
    "actor_id",
    "on_behalf_of_actor_id",
    "authority_grant_id",
    "target_stream_id",
    "expected_stream_version",
    "idempotency_key",
    "correlation_id",
    "causation_id",
    "reason",
    "evidence_refs",
    "payload",
    "project_id"
  ],
  "additionalProperties": false
}
