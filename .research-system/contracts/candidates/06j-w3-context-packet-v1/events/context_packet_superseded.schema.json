{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://core/event/ContextPacketSuperseded",
  "title": "W3 context lifecycle event: ContextPacketSuperseded",
  "type": "object",
  "properties": {
    "event_type": {
      "const": "ContextPacketSuperseded"
    },
    "schema_id": {
      "const": "ars://core/event/ContextPacketSuperseded"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "command_type": {
      "const": "SupersedeContextPacket"
    },
    "payload": {
      "properties": {
        "context_id": {
          "type": "string",
          "pattern": "^ctx_"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "packet_revision": {
          "type": "integer",
          "minimum": 1
        },
        "packet_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "replacement_context_id": {
          "type": "string",
          "pattern": "^ctx_"
        },
        "replacement_packet_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id",
        "request_id",
        "packet_revision",
        "packet_sha256",
        "replacement_context_id",
        "replacement_packet_sha256",
        "reason"
      ]
    }
  },
  "required": [
    "event_type",
    "schema_id",
    "schema_version",
    "command_type",
    "payload"
  ]
}
