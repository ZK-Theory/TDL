{
  "$id": "ars://policy/schema/artefact-consumer-predicates/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_state": {"const": "proposed"},
    "dimensions": {
      "const": [
        "availability",
        "regenerability",
        "integrity",
        "structural_validation",
        "scientific_review",
        "use_authority"
      ]
    },
    "predicates": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/predicate"}
    },
    "schema_id": {"const": "ars://policy/artefact-consumer-predicates"},
    "schema_version": {"const": "1.0.0"}
  },
  "required": ["schema_id", "schema_version", "candidate_state", "dimensions", "predicates"],
  "type": "object",
  "$defs": {
    "closedStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "dimensions": {
      "additionalProperties": false,
      "properties": {
        "availability": {"$ref": "#/$defs/closedStrings"},
        "regenerability": {"$ref": "#/$defs/closedStrings"},
        "integrity": {"$ref": "#/$defs/closedStrings"},
        "structural_validation": {"$ref": "#/$defs/closedStrings"},
        "scientific_review": {"$ref": "#/$defs/closedStrings"},
        "use_authority": {"$ref": "#/$defs/closedStrings"}
      },
      "required": [
        "availability",
        "regenerability",
        "integrity",
        "structural_validation",
        "scientific_review",
        "use_authority"
      ],
      "type": "object"
    },
    "predicate": {
      "additionalProperties": false,
      "properties": {
        "allowed_consumer_ids": {"$ref": "#/$defs/closedStrings"},
        "consumer_kind": {
          "enum": [
            "result_evidence",
            "review_evidence",
            "manuscript_evidence",
            "claim_evidence",
            "sensitive_sidecar"
          ]
        },
        "dimensions": {"$ref": "#/$defs/dimensions"},
        "predicate_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+-v1$"},
        "predicate_version": {"const": "1.0.0"},
        "required_decision_kind": {
          "oneOf": [{"type": "null"}, {"const": "claim_promotion"}]
        }
      },
      "required": [
        "predicate_id",
        "predicate_version",
        "consumer_kind",
        "allowed_consumer_ids",
        "dimensions",
        "required_decision_kind"
      ],
      "type": "object"
    }
  }
}
