#!/bin/bash
# Pre-commit hook — ACTIVE.
#
# This file lives in .githooks/ because the repository sets
#   core.hooksPath = .githooks
# Anything placed in .git/hooks/ is IGNORED by git. A hook installed there does
# not error — it simply never runs, silently. That is exactly what happened:
# core.hooksPath was set 2026-04-10 (a54a2c4) and the contract validator was
# installed to .git/hooks/pre-commit on 2026-05-27, where it never executed once.
# Install hooks with .claude/hooks/install-git-hooks.py, which now resolves
# core.hooksPath rather than hardcoding .git/hooks.
#
# .githooks/ is tracked, so these hooks apply to every clone and every linked
# worktree.
#
# Gates, in order — the first failure blocks the commit:
#   0. Dual-tree skill sync: .agents/skills/ (authoring source) and .claude/skills/
#      must stay mirrored, or a research-assurance skill is invisible to one runtime.
#   1. ruff lint + format, via the pre-commit framework (.pre-commit-config.yaml).
#   2. The math-correctness contract validator: meta-schema validation of every
#      contract, binding test_file existence + function presence (AST-checked),
#      pytest invocation of every bound test, and JSON-schema validation of
#      staged output files. See contracts/README.md.
#   3. No-new-diff: no gate may leave a tracked file dirty that was clean before
#      it ran. The two Repowise-owned tracked files are snapshotted before the
#      gates and restored before this comparison, because their writer is the
#      previous commit's background post-commit updater, not a gate.
#
# To bypass in a genuine emergency: git commit --no-verify. Project rules forbid
# this — if a gate fails, fix the cause.

set -o pipefail

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$REPO_ROOT" ]; then
  echo "ERROR: pre-commit could not locate the repo root via git rev-parse." >&2
  exit 2
fi

# Snapshot unstaged changes to tracked files before running any gate. These
# gates are validation, not producers — a gate mutating a tracked file it has
# no business touching must block the commit, not ride along silently (obs
# 01KYQ6AMEXS5SZEEGX9RB9QKHF: a timed-out `git commit`'s orphaned pre-commit
# children kept running and rewrote a clean, unstaged, unrelated `uv.lock`
# from revision 1 to revision 3 by the time they finished). The direct trigger
# (gate 3 re-entering `uv run` and syncing/re-locking the worktree's project)
# is gone now that gate 3 runs `sys.executable` directly, but this check
# guards the class, not just that one instance.
PRE_GATE_DIRTY=$(git diff --no-ext-diff --binary)
PRE_GATE_DIRTY_NAMES=$(git diff --name-only)

# Repowise-owned tracked files: snapshot now, restore before gate 3 compares.
#
# `.githooks/post-commit` fires `repowise update` into the background after every
# commit, and that updater rewrites two TRACKED files — the REPOWISE block in
# `.claude/CLAUDE.md` and the `last_commit_at_index` line in
# `.repowise-workspace.yaml`. When the next commit lands while that background
# refresh is still running, gate 3 sees a tracked file that changed during the
# gate window and blocks — reporting "a validation gate modified tracked files",
# which is a misdiagnosis: no gate wrote them, the previous commit's updater did
# (obs 2026-08-09-commit-gate-repowise-tracked-write: a documentation-only amend
# was blocked this way, and the retry left one or both files dirty afterwards).
#
# So for exactly these two paths the pre-commit path is made byte-neutral: their
# pre-gate bytes are snapshotted and restored before gate 3 runs. Gate 3 itself is
# NOT relaxed — it still blocks for every other tracked file, and it still blocks
# for these two if the author staged them (a staged path is the author's
# deliberate content and is never snapshotted or restored).
#
# What this does not do: the background updater that fires AFTER this commit will
# regenerate both files again, so a refreshed index still shows up as an unstaged
# diff between commits. That is the auto-sync working as designed. The property
# restored here is narrower and is the one the observation asked for — the commit
# validation path does not itself change tracked setup bytes.
REPOWISE_OWNED_PATHS=".claude/CLAUDE.md .repowise-workspace.yaml"
REPOWISE_SNAPSHOT_DIR=""
_repowise_staged=$(git diff --cached --name-only 2>/dev/null)
if REPOWISE_SNAPSHOT_DIR=$(mktemp -d 2>/dev/null); then
  for _repowise_path in $REPOWISE_OWNED_PATHS; do
    if printf '%s\n' "$_repowise_staged" | grep -qxF -- "$_repowise_path"; then
      continue
    fi
    [ -f "$REPO_ROOT/$_repowise_path" ] || continue
    if [ -L "$REPO_ROOT/$_repowise_path" ]; then
      continue
    fi
    mkdir -p "$REPOWISE_SNAPSHOT_DIR/$(dirname "$_repowise_path")" 2>/dev/null || continue
    cp "$REPO_ROOT/$_repowise_path" "$REPOWISE_SNAPSHOT_DIR/$_repowise_path" 2>/dev/null || true
  done
else
  REPOWISE_SNAPSHOT_DIR=""
fi

# Restore the snapshotted Repowise-owned files to their pre-gate bytes. Called
# once, immediately before gate 3, and on every early-exit path so a blocked
# commit does not leave the worktree holding a mid-gate refresh either.
restore_repowise_owned() {
  [ -n "$REPOWISE_SNAPSHOT_DIR" ] || return 0
  _repowise_restored=""
  for _repowise_path in $REPOWISE_OWNED_PATHS; do
    [ -f "$REPOWISE_SNAPSHOT_DIR/$_repowise_path" ] || continue
    if ! cmp -s "$REPOWISE_SNAPSHOT_DIR/$_repowise_path" "$REPO_ROOT/$_repowise_path" 2>/dev/null; then
      if cp "$REPOWISE_SNAPSHOT_DIR/$_repowise_path" "$REPO_ROOT/$_repowise_path" 2>/dev/null; then
        _repowise_restored="$_repowise_restored $_repowise_path"
      fi
    fi
  done
  rm -rf "$REPOWISE_SNAPSHOT_DIR" 2>/dev/null || true
  REPOWISE_SNAPSHOT_DIR=""
  if [ -n "$_repowise_restored" ]; then
    # Positive execution signal: this path is silent unless it acted, and when it
    # acts it names what it touched. A restore line means the background updater
    # overlapped this commit — not that a gate misbehaved.
    echo "pre-commit: restored Repowise-owned tracked file(s) to their pre-gate bytes:$_repowise_restored" >&2
  fi
}
trap restore_repowise_owned EXIT

# Interpreter resolution, needed by gates 0 and 2 alike.
#
# A linked worktree has its own (often bare) venv: `uv run` there either attempts a
# re-sync mid-commit — which can hit a Windows file lock — or, with --no-sync, runs
# against an environment missing jsonschema and fails the gate spuriously. Either way
# every Worker commit in a worktree would be blocked by plumbing rather than by a real
# breach.
#
# So: take the interpreter from the MAIN repository (git-common-dir's parent, which is
# the main checkout even when we are inside a linked worktree) while still validating
# THIS working tree's files — each checker resolves its own targets from
# `git rev-parse --show-toplevel`.
GIT_COMMON=$(git rev-parse --git-common-dir 2>/dev/null)
if [ -n "$GIT_COMMON" ]; then
  MAIN_ROOT=$(cd "$(dirname "$GIT_COMMON")" 2>/dev/null && pwd)
fi
[ -z "$MAIN_ROOT" ] && MAIN_ROOT="$REPO_ROOT"

if [ -f "$MAIN_ROOT/.venv/Scripts/python.exe" ]; then
  MAIN_PYTHON="$MAIN_ROOT/.venv/Scripts/python.exe"
elif [ -x "$MAIN_ROOT/.venv/bin/python" ]; then
  MAIN_PYTHON="$MAIN_ROOT/.venv/bin/python"
else
  echo "ERROR: pre-commit requires the populated main-checkout interpreter at $MAIN_ROOT/.venv." >&2
  echo "Create or repair that environment outside this linked worktree, then retry." >&2
  exit 2
fi

# Gate 0 — dual-tree skill sync. Fast filecmp; the message names the fix.
#
# This gate is documented in CONVENTIONS.md as "pre-commit Gate 0", but until now it
# lived only in .claude/hooks/git-pre-commit.sh — a copy staged into .git/hooks, which
# core.hooksPath makes git ignore. It had therefore never run: three files advertised a
# gate that did not exist. Same silent-absence shape as the contract validator itself.
if ! "$MAIN_PYTHON" "$REPO_ROOT/tools/sync_agent_skills.py" --check; then
  echo "" >&2
  echo "pre-commit: skill trees diverged — commit blocked." >&2
  echo "Fix: \"$MAIN_PYTHON\" \"$REPO_ROOT/tools/sync_agent_skills.py\"" >&2
  exit 1
fi

# Gate 1 — ruff via the pre-commit framework, when it is available.
if command -v pre-commit >/dev/null 2>&1 && [ -f "$REPO_ROOT/.pre-commit-config.yaml" ]; then
  if ! pre-commit run --config "$REPO_ROOT/.pre-commit-config.yaml"; then
    echo "" >&2
    echo "pre-commit: ruff gate FAILED — commit blocked." >&2
    exit 1
  fi
fi

# Gate 2 — math-correctness contract validator. Materialize the Git index in a
# disposable directory so unrelated unstaged files cannot change commit
# admissibility. The runner reuses MAIN_PYTHON and exposes the current Git
# object database to provenance tests without exposing working-copy bytes.
if ! "$MAIN_PYTHON" "$REPO_ROOT/.claude/hooks/run_staged_contract_gate.py" --repo-root "$REPO_ROOT" -- "$@"; then
  echo "" >&2
  echo "pre-commit: contract gate FAILED — commit blocked. See contracts/README.md." >&2
  exit 1
fi

# Restore the Repowise-owned files first, so gate 3 compares like for like: a
# background `repowise update` from the PREVIOUS commit overlapping this one is
# not a gate side effect and must not be reported as one.
restore_repowise_owned

# Gate 3 — no-new-diff: every gate above is validation, and validation must be
# read-only. If any of them left a tracked file dirty that wasn't dirty before
# they ran, that is exactly the obs 01KYQ6AMEXS5SZEEGX9RB9QKHF failure shape —
# block rather than let it ride into the commit unremarked.
POST_GATE_DIRTY=$(git diff --no-ext-diff --binary)
POST_GATE_DIRTY_NAMES=$(git diff --name-only)
if [ "$PRE_GATE_DIRTY" != "$POST_GATE_DIRTY" ]; then
  echo "" >&2
  echo "pre-commit: a validation gate modified tracked file(s) outside the staged set — commit blocked." >&2
  echo "Unstaged tracked diff before gates ran:" >&2
  echo "${PRE_GATE_DIRTY_NAMES:-  (none)}" >&2
  echo "Unstaged tracked diff after gates ran:" >&2
  echo "${POST_GATE_DIRTY_NAMES:-  (none)}" >&2
  echo "Gates validate; they must not write. Investigate before retrying." >&2
  exit 1
fi

exit 0
