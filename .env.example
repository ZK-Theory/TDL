# Copy this file to .env and load it before running numerical scripts.
# These variables pin BLAS thread counts for cross-machine numerical determinism.
# Without these, BLAS (MKL, OpenBLAS) spawns multiple threads that introduce
# non-deterministic floating-point reduction orderings. Pinning to 1 thread
# ensures TDA pipeline outputs (persistence diagrams, Wasserstein distances,
# Markov null permutations, bootstrap CIs) are bit-for-bit reproducible.
MKL_NUM_THREADS=1
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1

# Loading instructions:
#   PowerShell: Get-Content .env | ForEach-Object { $k,$v = $_ -split '=',2; if ($k -and !$k.StartsWith('#')) { [System.Environment]::SetEnvironmentVariable($k.Trim(), $v.Trim()) } }
#   uv run:     uv run --env-file .env python your_script.py
#   Bash:       set -a; source .env; set +a
