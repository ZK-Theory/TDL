{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks remind --client=claude-code"
          }
        ]
      },
      {
        "matcher": "mcp__serena__*",
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks auto-approve --client=claude-code"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "'c:\\Users\\steph\\TDL\\.codex\\hooks\\notation-guard.sh'",
            "timeout": 2000,
            "statusMessage": "Checking notation conventions..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"c:\\Users\\steph\\TDL\\.codex\\hooks\\ruff_fix.py\"",
            "timeout": 30,
            "statusMessage": "Linting and formatting..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "'c:\\Users\\steph\\TDL\\.codex\\hooks\\research-context-check.sh'",
            "timeout": 10,
            "statusMessage": "Checking research context header..."
          },
          {
            "type": "command",
            "command": "'c:\\Users\\steph\\TDL\\.codex\\hooks\\results-vault-reminder.sh'",
            "timeout": 5,
            "statusMessage": "Checking for vault reminder..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks activate --client=claude-code"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks cleanup --client=claude-code"
          }
        ]
      }
    ]
  }
}
